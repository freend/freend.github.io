---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TechnicalExperience from '../components/TechnicalExperience.astro';
import { SITE_TITLE } from '../consts';

const representativeExperience = [
	{
		title: 'AWS 인프라 설계·구축·운영',
		body: 'AWS 기반 서비스 인프라를 직접 설계·구축하고 운영했습니다. 기존 AWS 리소스 약 320개를 Terraform 관리 대상으로 편입하고, 최종 terraform plan에서 추가·변경·삭제가 없는 상태를 확인했습니다.',
		href: '/portfolio/aws-infrastructure-as-code',
		link: 'Terraform 사례 보기',
	},
	{
		title: 'Kubernetes 플랫폼 운영',
		body: 'EKS에서 Deployment·Service·HTTPRoute로 워크로드 배포와 Gateway API 요청 경로를 구성했습니다. Karpenter 노드 풀과 Prometheus·Loki·Alloy 관측 구성을 함께 관리했습니다.',
		href: '/portfolio/kubernetes-platform-engineering',
		link: '플랫폼 경험 보기',
	},
	{
		title: '백엔드와 데이터 흐름 구현',
		body: '도메인별 저장소의 통계를 집계하는 API를 구현해 대시보드에서 수집 현황과 추세를 확인하도록 했습니다. Kafka·ksqlDB 파이프라인에서는 제품 목록 필드를 문자열에서 배열·맵 구조로 변환하도록 구성했습니다.',
		href: '/portfolio',
		link: '백엔드·데이터 프로젝트 보기',
	},
	{
		title: '로컬 AI 추론 파이프라인',
		body: 'Python·FFmpeg로 영상 프레임을 처리해 Mac과 Linux의 로컬 VLM에 연결했습니다. 모델 응답을 구조화하고, 추출 항목과 입력 프레임을 비교해 결과를 검증했습니다.',
		href: '/portfolio/linux-qwen-extraction',
		link: 'Local AI 경험 보기',
	},
];

const engineeringSteps = [
	{ title: '문제를 구체화합니다', body: '요청 실패와 운영 맥락을 살펴 재현 조건과 완료 기준을 정합니다.' },
	{ title: '구조와 영향 범위를 파악합니다', body: 'AWS 리소스 참조, Kubernetes 요청 경로, 데이터 흐름을 따라 변경 지점을 좁힙니다.' },
	{ title: '구현하고 반복 작업을 자동화합니다', body: '서비스 로직을 구현하고, 반복되는 인프라·서버 설정은 Terraform과 Ansible로 코드화합니다.' },
	{ title: '실행 결과를 검증하고 운영합니다', body: 'plan·diff와 테스트·실행 결과를 확인하고, 배포 뒤 readiness와 서비스 상태를 살핍니다.' },
];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={`${SITE_TITLE} | DevOps & Platform Engineer`}
			description="클라우드 인프라와 플랫폼 운영부터 백엔드, 데이터 시스템, 로컬 AI 추론까지 구현하고 운영하는 DevOps & Platform Engineer 최수만의 포트폴리오입니다."
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero" aria-labelledby="hero-title">
				<p class="eyebrow">SOFTWARE ENGINEERING · CLOUD · PLATFORM</p>
				<h1 id="hero-title">서비스 전체를 이해하고<br />문제를 끝까지 해결하는 <span class="hero-title-role">엔지니어</span></h1>
				<p class="hero-lede">프론트엔드부터 백엔드, 데이터 시스템, 클라우드 인프라까지 직접 구축하고 운영해 왔습니다.</p>
				<p class="hero-intro">서비스의 기능 구현부터 배포와 운영까지, 코드와 자동화로 문제를 해결합니다.</p>
				<div class="hero-actions">
					<a class="button button-primary" href="/portfolio">프로젝트 보기 <span aria-hidden="true">→</span></a>
					<a class="button button-secondary" href="/blog">기술 블로그 <span aria-hidden="true">→</span></a>
				</div>
			</section>

			<section class="experience-section" aria-labelledby="experience-title">
				<div class="section-heading">
					<p class="eyebrow">SELECTED EXPERIENCE</p>
					<h2 id="experience-title">인프라부터 서비스 구현까지 맡아 온 일</h2>
				</div>
				<div class="experience-grid">
					{representativeExperience.map((item) => (
						<article class="experience-card">
							<h3>{item.title}</h3>
							<p>{item.body}</p>
							<a href={item.href}>{item.link}<span aria-hidden="true"> →</span></a>
						</article>
					))}
				</div>
			</section>

			<section class="engineering-section" aria-labelledby="engineering-title">
				<div class="section-heading">
					<p class="eyebrow">HOW I ENGINEER</p>
					<h2 id="engineering-title">문제 정의부터 운영 결과까지 연결합니다</h2>
				</div>
				<div class="engineering-grid">
					{engineeringSteps.map((step, index) => (
						<article class="engineering-step">
							<p class="step-number">0{index + 1}</p>
							<h3>{step.title}</h3>
							<p>{step.body}</p>
						</article>
					))}
				</div>
				<p class="engineering-note">코드 변경이 요청·데이터·인프라 흐름에 미치는 영향을 확인하고, 실행 결과를 근거로 다음 조치를 결정합니다.</p>
			</section>

			<TechnicalExperience />

		</main>
		<Footer />
	</body>
</html>

<style>
	.hero { padding: 2.5rem 0 2.75rem; border-bottom: 1px solid var(--border); }
	.eyebrow { margin: 0 0 0.75rem; color: var(--link); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; }
	.hero h1 { max-width: 700px; margin: 0; padding: 0; border: 0; font-size: clamp(2rem, 6vw, 3.25rem); line-height: 1.16; letter-spacing: -0.035em; }
	.hero-lede { margin: 1.25rem 0 0.6rem; font-size: 1.2rem; font-weight: 600; }
	.hero-intro { max-width: 720px; margin: 0; color: var(--text); font-size: 1.08rem; line-height: 1.8; }
	.hero-actions { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 1.5rem; }
	.button { display: inline-flex; gap: 0.6rem; align-items: center; padding: 0.65rem 0.95rem; border: 1px solid var(--border); border-radius: 6px; font-weight: 600; }
	.button-primary { border-color: var(--link); background: var(--link); color: #fff; }
	.button-secondary { background: var(--bg); }
	.experience-section, .engineering-section { margin: 3.5rem 0; }
	.section-heading { margin-bottom: 1.25rem; }
	.section-heading h2 { margin: 0; }
	.experience-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
	.experience-card { min-width: 0; padding: 1.25rem; border: 1px solid var(--border); border-radius: 8px; }
	.experience-card h3, .engineering-step h3 { margin: 0 0 0.65rem; font-size: 1.1rem; }
	.experience-card p, .engineering-step > p:last-child { margin: 0; color: var(--text); font-size: 1rem; line-height: 1.75; }
	.experience-card a { display: inline-block; margin-top: 0.85rem; font-size: 0.95rem; font-weight: 600; }
	.engineering-note { margin: 1rem 0 0; line-height: 1.75; }
	.engineering-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
	.engineering-step { min-width: 0; padding: 1.2rem; border: 1px solid var(--border); border-top: 2px solid var(--link); border-radius: 8px; background: var(--code-bg); }
	.step-number { margin: 0 0 0.75rem; color: var(--link); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; }
	.experience-card a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
	.button:focus-visible, .experience-card a:focus-visible { outline: 3px solid var(--link); outline-offset: 3px; }
	@media (prefers-color-scheme: dark) { .button-primary { color: #0d1117; } }
	@media (max-width: 700px) {
		.hero h1 .hero-title-role { white-space: nowrap; }
		.experience-grid { grid-template-columns: 1fr; }
	}
	@media (max-width: 600px) { .engineering-grid { grid-template-columns: 1fr; } }
</style>
