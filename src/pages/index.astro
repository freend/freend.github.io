---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				padding: 2rem 0;
				border-bottom: 1px solid var(--border);
				margin-bottom: 2rem;
			}
			.hero h1 {
				margin: 0;
				border: none;
				padding: 0;
				font-size: 2.5rem;
			}
			.hero p {
				font-size: 1.25rem;
				color: #656d76;
				margin-top: 0.5rem;
			}
			section {
				line-height: 1.6;
			}
			section h2 {
				border: none;
				margin-top: 2rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<h1>{SITE_TITLE}</h1>
				<p>{SITE_DESCRIPTION}</p>
			</div>
			
			<section>
				<p>
					Welcome to my minimal dev blog. I believe that content and logic should speak louder than flashy designs.
				</p>
				<p>
					Here, I document my journey through random projects, technical deep dives, and daily engineering struggles.
				</p>
				
				<h2>Explore</h2>
				<ul>
					<li>Check out my <a href="/blog">Technical Blog</a></li>
					<li>Learn more <a href="/about">About Me</a></li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
