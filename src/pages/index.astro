---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{SITE_TITLE}</h1>
			<p>
				{SITE_DESCRIPTION}
			</p>
			<p>
				This is a minimalist blog created for documenting random projects and thoughts. 
				No design, no distractions. Just content.
			</p>
			<p>
				Check out the <a href="/blog">Blog</a> section to see what I'm working on.
			</p>
		</main>
		<Footer />
	</body>
</html>
