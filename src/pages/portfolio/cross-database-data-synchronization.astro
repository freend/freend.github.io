---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const stack = ['Apache Kafka', 'Confluent Platform', 'Apache Avro', 'Kafka Connect', 'Schema Registry'];
const stackBadges = [
	{ name: 'Apache Kafka', url: 'https://img.shields.io/badge/Apache_Kafka-231F20?style=for-the-badge&logo=apachekafka&logoColor=white' },
	{ name: 'Confluent', url: 'https://img.shields.io/badge/Confluent-1C1C1C?style=for-the-badge&logo=confluent&logoColor=white' },
	{ name: 'Apache Avro', url: 'https://img.shields.io/badge/Apache_Avro-4B32C3?style=for-the-badge&logo=apache&logoColor=white' },
	{ name: 'Kafka Connect', url: 'https://img.shields.io/badge/Kafka_Connect-231F20?style=for-the-badge&logo=apachekafka&logoColor=white' },
	{ name: 'Schema Registry', url: 'https://img.shields.io/badge/Schema_Registry-1C1C1C?style=for-the-badge&logo=confluent&logoColor=white' },
];

const sections = [
	{
		eyebrow: '01 · WHY',
		title: '서로 다른 저장소의 변경 데이터를 연결',
		paragraphs: [
			'서비스는 RDS, Neo4j, Elasticsearch 등 서로 다른 저장소를 사용했습니다. 저장소별 데이터를 각각 추출해 대량 배치로 맞추기보다, 변경분을 전달하고 목적지 구조에 맞춰 변환하는 공통 흐름이 필요했습니다.',
			'구체적인 구현 사례는 RDS 변경 데이터를 Elasticsearch 문서로 동기화한 파이프라인입니다.',
		],
	},
	{
		eyebrow: '02 · HOW',
		title: '수집·변환·적재를 Kafka 파이프라인으로 분리',
		paragraphs: [
			'Kafka Connect JDBC Source Connector가 RDS 변경 데이터를 수집하고, ksqlDB가 이를 Elasticsearch 문서 구조로 변환합니다. 수집 결과와 변환 결과를 각각 Kafka 토픽에 전달한 뒤 Sink Connector가 Elasticsearch에 적재하도록 단계별 흐름을 구성했습니다.',
		],
		flowSteps: [
			{ label: 'RDS', detail: '원본 데이터' },
			{ label: 'JDBC Source Connector', detail: '변경분 수집' },
			{ label: 'Kafka Topic A', detail: '수집 레코드' },
			{ label: 'ksqlDB', detail: '문서 구조 변환' },
			{ label: 'Kafka Topic B', detail: '변환 레코드' },
			{ label: 'Elasticsearch Sink Connector', detail: 'ID 기준 Upsert' },
			{ label: 'Elasticsearch', detail: '검색 문서' },
		],
	},
	{
		eyebrow: '03 · WHAT',
		title: 'RDS 변경 데이터를 Elasticsearch 문서로 연결',
		bullets: [
			'JDBC Source Connector를 updated_at 컬럼 기준의 주기 조회로 구성해 변경분을 원본 토픽으로 보냈습니다.',
			'ksqlDB에서 Elasticsearch가 소비하는 JSON·배열 필드 구조를 만들고 변환 결과를 별도 토픽에 기록했습니다.',
			'Elasticsearch Sink Connector는 기본 키 또는 문서 ID를 문서 식별에 사용해 신규 문서를 만들고 기존 문서를 갱신하도록 구성했습니다.',
		],
	},
	{
		eyebrow: '04 · ENGINEERING DECISIONS',
		title: '원본 수집과 목적지별 변환을 분리',
		paragraphs: [
			'JDBC Source Connector에는 RDS 변경분 수집을 맡기고, Elasticsearch 문서 가공은 ksqlDB에서 처리했습니다. 수집 토픽과 변환 토픽을 나눠 원본 전달 경로와 목적지별 변환 책임을 분리했습니다.',
			'레코드 구조는 Avro 스키마로 정의하고, Schema Registry를 ksqlDB와 연결해 스키마 정보를 다루도록 구성했습니다. Kafka Connect 실행 설정은 JSON Converter를 사용해 커넥터 구간의 데이터 표현을 구분했습니다.',
		],
	},
];
---

<PortfolioProjectDetail
	title="Cross-Database Data Synchronization"
	eyebrow="직접 설계·구축·관리 · Data Engineering"
	subtitle="RDS 변경 데이터를 Elasticsearch 문서로 전달하는 Kafka 파이프라인"
	description="Kafka Connect JDBC Source Connector, ksqlDB, Elasticsearch Sink Connector를 연결해 RDS 데이터를 Elasticsearch 문서 구조로 변환·동기화한 경험입니다."
	stack={stack}
	stackBadges={stackBadges}
	sections={sections}
/>
