---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const stack = ['Apache Kafka', 'Confluent Platform', 'Kafka Connect', 'ksqlDB', 'Amazon RDS', 'Elasticsearch'];
const stackBadges = [
	{ name: 'Apache Kafka', url: 'https://img.shields.io/badge/Apache_Kafka-231F20?style=for-the-badge&logo=apachekafka&logoColor=white' },
	{ name: 'Confluent', url: 'https://img.shields.io/badge/Confluent-1C1C1C?style=for-the-badge&logo=confluent&logoColor=white' },
	{ name: 'Kafka Connect', url: 'https://img.shields.io/badge/Kafka_Connect-231F20?style=for-the-badge&logo=apachekafka&logoColor=white' },
	{ name: 'ksqlDB', url: 'https://img.shields.io/badge/ksqlDB-231F20?style=for-the-badge&logo=apachekafka&logoColor=white' },
	{ name: 'Amazon RDS', url: 'https://img.shields.io/badge/Amazon_RDS-527FFF?style=for-the-badge&logo=amazonaws&logoColor=white' },
	{ name: 'Elasticsearch', url: 'https://img.shields.io/badge/Elasticsearch-005571?style=for-the-badge&logo=elasticsearch&logoColor=white' },
];

const sections = [
	{
		eyebrow: '01 · WHY',
		title: 'RDS의 목록 필드를 검색 문서 구조로 변환',
		paragraphs: [
			'서비스는 RDS, Neo4j, Elasticsearch 등 서로 다른 저장소를 사용했습니다. 이 사례에서는 RDS의 제품 데이터를 Kafka를 통해 전달하고, Elasticsearch에서 활용할 구조로 변환했습니다. 입력 데이터의 `product_list`와 `spec_list`는 문자열이었고, 결과에서는 배열 안의 key-value map 구조로 다뤘습니다.',
			'데이터베이스 연결, 토픽을 통한 전달, 목적지에서 활용할 데이터 구조 변환을 각 단계에 나눠 구성했습니다.',
		],
	},
	{
		eyebrow: '02 · HOW',
		title: 'RDS에서 Elasticsearch까지 이어지는 데이터 경로',
		flowLayout: 'horizontal-scroll',
		paragraphs: [
			'JDBC Source Connector는 MariaDB JDBC 드라이버로 AWS RDS에 연결합니다. Kafka 토픽의 JSON 제품 데이터를 ksqlDB 입력 테이블에서 읽고, 지속 실행 CTAS 쿼리로 변환해 결과 토픽에 기록합니다. Elasticsearch Sink Connector는 그 결과 토픽을 구독해 Elasticsearch로 전달합니다.',
		],
		flowSteps: [
			{ label: 'RDS', detail: '제품 데이터' },
			{ label: 'JDBC Source Connector', detail: 'MariaDB JDBC 드라이버로 연결' },
			{ label: 'Kafka · 입력 토픽', detail: 'JSON 제품 데이터' },
			{ label: 'ksqlDB · 입력 테이블', detail: 'id와 문자열 목록 필드' },
			{ label: 'ksqlDB · CTAS', detail: '문자열 목록을 배열·맵으로 변환' },
			{ label: 'Kafka · 결과 토픽', detail: 'Elasticsearch Sink가 구독' },
			{ label: 'Elasticsearch Sink', detail: 'Long Key · JSON Value' },
			{ label: 'Elasticsearch', detail: '검색 데이터 저장소' },
		],
	},
	{
		eyebrow: '03 · WHAT',
		title: '문자열 목록을 배열 안의 map 구조로 변환',
		bullets: [
			'ksqlDB 입력 테이블은 `id`를 `BIGINT` 기본 키로 사용하고 `product_list`, `spec_list`를 `STRING`으로 읽습니다. 결과 테이블은 두 목록 필드를 `ARRAY<MAP<STRING, STRING>>`으로 정의합니다. 입력과 결과의 Value Format은 JSON이고 Key Format은 KAFKA입니다.',
			"지속 실행 `CREATE TABLE AS SELECT ... EMIT CHANGES` 쿼리는 두 목록 필드에서 `REPLACE('},{', '}!{')`로 항목 경계를 표시한 뒤 `SPLIT`하고, `TRANSFORM(..., JSON_RECORDS(...))`를 적용해 배열·맵 구조로 만듭니다.",
			'Elasticsearch Sink Connector는 ksqlDB 결과 테이블의 출력 토픽을 구독합니다. Key Converter는 `LongConverter`, Value Converter는 `JsonConverter`로 구성했습니다.',
		],
	},
	{
		eyebrow: '04 · ENGINEERING DECISIONS',
		title: '저장소 연동과 데이터 변환의 책임을 분리',
		paragraphs: [
			'JDBC Source Connector는 RDS 연동을, Elasticsearch Sink Connector는 결과 토픽을 검색 저장소로 전달하는 일을 맡습니다. Kafka의 입력 토픽과 결과 토픽을 나누어 수집 데이터와 변환 데이터를 구분하고, ksqlDB를 그 사이의 변환 계층으로 뒀습니다.',
			'제품 데이터의 `product_list`와 `spec_list`는 입력 테이블에서 문자열이고 결과 테이블에서는 배열·맵 구조입니다. ksqlDB에서 이 구조를 변환해 Elasticsearch가 소비할 결과 레코드로 전달하도록 구성했습니다.',
		],
	},
];
---

<PortfolioProjectDetail
	title="Cross-Database Data Synchronization"
	eyebrow="직접 설계·구축·관리 · Data Engineering"
	subtitle="RDS에서 검색 저장소까지 연결한 Kafka 데이터 파이프라인"
	description="RDS용 JDBC Source Connector와 ksqlDB의 JSON 구조 변환, Elasticsearch Sink의 결과 토픽 구독을 구성한 이기종 데이터 동기화 사례입니다."
	stack={stack}
	stackBadges={stackBadges}
	sections={sections}
/>
