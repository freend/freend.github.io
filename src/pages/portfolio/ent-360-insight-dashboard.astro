---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const stack = ['Next.js', 'React', 'TypeScript', 'Tailwind CSS', 'Python', 'FastAPI', 'Docker'];
const stackBadges = [
	{ name: 'Next.js', url: 'https://img.shields.io/badge/Next.js-black?style=for-the-badge&logo=next.js&logoColor=white' },
	{ name: 'React', url: 'https://img.shields.io/badge/React-20232A?style=for-the-badge&logo=react&logoColor=61DAFB' },
	{ name: 'TypeScript', url: 'https://img.shields.io/badge/TypeScript-3178C6?style=for-the-badge&logo=typescript&logoColor=white' },
	{ name: 'Tailwind CSS', url: 'https://img.shields.io/badge/Tailwind_CSS-06B6D4?style=for-the-badge&logo=tailwindcss&logoColor=white' },
	{ name: 'Python', url: 'https://img.shields.io/badge/Python-3670A0?style=for-the-badge&logo=python&logoColor=ffdd54' },
	{ name: 'FastAPI', url: 'https://img.shields.io/badge/FastAPI-009688?style=for-the-badge&logo=fastapi&logoColor=white' },
	{ name: 'Docker', url: 'https://img.shields.io/badge/Docker-2496ED?style=for-the-badge&logo=docker&logoColor=white' },
];

const sections = [
	{
		eyebrow: '01 · 문제와 해결 방식',
		title: '분산된 수집 통계를 운영자가 한 화면에서 탐색하도록',
		paragraphs: [
			'운영자가 여러 수집 시스템의 통계와 추이를 각각 확인해야 했습니다. Collect Dashboard API가 집계해 제공하는 통계를 Ent-360 대시보드에 연결해 도메인별 현황과 상세 추이를 한곳에서 탐색하도록 구현했습니다.',
			'백엔드 통계 집계는 Collect Dashboard API가 담당하고, Ent-360은 그 응답을 운영자가 확인할 수 있는 화면으로 시각화합니다.',
		],
		cards: [
			{ title: 'BEFORE · 개별 확인', body: '운영자가 수집 시스템별 통계와 추이를 따로 확인' },
			{ title: 'AFTER · 대시보드 탐색', body: '도메인별 요약 카드에서 현황을 확인하고 상세 통계 모달에서 추이를 탐색' },
		],
	},
	{
		eyebrow: '02 · 운영자 대시보드 구현',
		title: '도메인별 요약에서 상세 통계까지 이어지는 화면',
		paragraphs: [
			'운영자는 기업·재무·고용, 특허, 공시·외감, 벤처 통계의 요약 카드를 확인하고 관심 있는 항목을 선택해 상세 통계 모달에서 추이와 세부 데이터를 살펴봅니다.',
			'도메인별 요청과 로딩 상태를 나누어 관리해 응답 상황을 각 통계 영역에 반영했습니다.',
		],
		bullets: [
			'기업·재무·고용 통계를 요약 카드와 상세 데이터로 제공',
			'특허, 공시·외감, 벤처 통계를 도메인별로 구분',
			'요약 카드 선택에서 상세 통계 모달로 이어지는 탐색',
		],
	},
	{
		eyebrow: '03 · API 연결 및 데이터 흐름',
		title: 'Next.js 화면에서 통계 API까지 요청 흐름 구성',
		paragraphs: [
			'브라우저의 Next.js 화면은 상대 경로 `/api/v1`을 호출하고, Middleware가 요청을 서버에서 전달합니다. Collect Dashboard API의 연결 주소는 실행 시점의 `BACKEND_URL`에서 읽어 빌드 결과와 실행 환경 설정을 분리했습니다.',
			'DashboardMain은 기업·특허·공시·벤처 통계 요청을 구성합니다. statsService는 API 응답을 화면에서 사용하는 통계 모델로 정리하고, 여러 응답이 필요한 영역은 Promise.all로 함께 조회합니다.',
		],
		flow: ['운영자 대시보드', 'Next.js 화면의 /api/v1 호출', 'Middleware의 서버 측 요청 전달', 'Collect Dashboard API', '통계 응답 및 화면 상태 갱신'],
	},
	{
		eyebrow: '04 · 실행 환경 설계',
		title: '한 번 빌드한 웹 결과물을 실행 설정과 분리',
		paragraphs: [
			'Next.js standalone 출력을 사용하고 Docker multi-stage 빌드에서 의존성 설치, 애플리케이션 빌드, 실행 이미지를 나눴습니다. 실행 이미지는 standalone 서버와 정적 산출물만 포함하고 비특권 사용자로 구동합니다.',
			'API 대상은 미들웨어가 런타임 환경 변수에서 읽습니다. 따라서 백엔드 연결 설정을 바꿀 때 웹을 다시 빌드하지 않고 실행 환경에서 연결 대상을 지정할 수 있습니다.',
		],
		flow: ['Next.js standalone build', 'Docker runner image', 'Runtime BACKEND_URL', 'Collect Dashboard API'],
	},
	{
		eyebrow: '05 · 화면 검증',
		title: '대시보드 모듈과 API 데이터 표시를 E2E 시나리오로 확인',
		paragraphs: [
			'Playwright 테스트는 대시보드 주요 모듈 렌더링, 기업 API 연결, 기업·특허·공시·벤처 데이터 표시와 통계 응답 스키마를 다룹니다. 웹 프로젝트에는 이 시나리오를 실행하는 `test:e2e` 명령이 있습니다.',
		],
	},
	{
		eyebrow: '06 · AI 활용 개발',
		title: 'API 명세와 UI 설계 규칙을 개발 컨텍스트로 활용',
		paragraphs: [
			'FastAPI가 제공하는 `openapi.json`을 AI 코딩 에이전트가 엔드포인트와 요청·응답 구조를 파악하는 참고 자료로 활용했습니다. 명세를 개발 컨텍스트로 제공해 API 구조를 이해하고 프런트엔드 연동을 진행했습니다.',
			'`front-guide-mcp`는 디자인 토큰과 컴포넌트 기준 등 UI 설계 규칙을 확인하는 데 사용했습니다. OpenAPI 명세는 API 구조 이해에, MCP는 화면 구현 기준 확인에 활용했습니다.',
		],
	},
];
---

<PortfolioProjectDetail
	title="Ent-360 Insight Dashboard"
	eyebrow="Data Platform · Frontend Engineering"
	subtitle="분산된 수집 현황을 운영자가 읽을 수 있는 대시보드로"
	description="Collect Dashboard API의 통계와 기업 데이터를 요약 지표, 도메인별 상세 화면으로 연결한 Next.js 웹 대시보드입니다."
	stack={stack}
	stackBadges={stackBadges}
	sections={sections}
	relatedLinks={[{ label: 'Collect Dashboard API 백엔드 상세', href: '/portfolio/collect-dashboard-api' }]}
/>
