---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const sections = [
	{
		eyebrow: '개요와 배경',
		title: '기업 데이터를 한 흐름으로 살펴보는 대시보드',
		paragraphs: [
			'기업 기본 정보, 재무·고용 자료, 공시와 감사보고서, 특허 및 벤처 데이터를 통합 조회하고 분석할 수 있도록 만든 풀스택 대시보드입니다.',
			'데이터 영역별로 나뉜 정보를 화면을 오가며 확인하는 대신, 기업을 중심으로 관련 정보를 이어 살펴보는 것이 프로젝트의 목적입니다.',
		],
	},
	{
		eyebrow: '주요 기능',
		title: '조회와 통계를 연결하는 화면',
		bullets: [
			'기업별 기본 정보와 재무·고용 정보를 함께 조회합니다.',
			'공시 및 감사보고서 데이터와 특허·벤처 정보를 살펴봅니다.',
			'수집 현황과 주요 지표를 통계 대시보드에서 확인합니다.',
			'화면별 서비스 모듈을 통해 백엔드 API와 데이터를 주고받습니다.',
		],
	},
	{
		eyebrow: '아키텍처와 구현',
		title: '화면, API 연동, 컨테이너 구성을 분리',
		cards: [
			{ title: '웹 애플리케이션', body: 'Next.js App Router와 React, TypeScript로 기업·공시·감사·특허·벤처 등의 화면을 구성합니다. 화면별 서비스 코드가 API 응답을 사용합니다.' },
			{ title: '서버 연동', body: '미들웨어에서 서버 측 요청을 다른 경로로 전달하는 구성이 확인됩니다. 이 설명에는 내부 주소나 환경 설정 값을 포함하지 않습니다.' },
			{ title: '빌드와 컨테이너', body: 'Next.js standalone 출력과 Dockerfile, Compose 구성이 있습니다. 이 저장소 설정은 배포 구조를 설명하며 현재 운영 상태를 뜻하지는 않습니다.' },
		],
		note: '대시보드 웹 저장소의 구현과 의존성에서 확인한 내용을 중심으로 소개합니다. API 기술은 별도 API 프로젝트 상세 페이지에 확인 범위를 구분해 적었습니다.',
	},
	{
		eyebrow: '기술 스택',
		title: '프로젝트에서 확인한 기술',
		paragraphs: ['웹 의존성 파일과 README에서 확인한 Next.js, React, TypeScript, Tailwind CSS, Docker 기반 구성에 더해, 연결된 API 프로젝트의 개발 브랜치에서 Python과 FastAPI를 확인했습니다.'],
		note: 'API 구현이 확인된 개발 브랜치는 main에 반영된 상태로 확인되지 않았습니다. 따라서 해당 API 구현이나 배포가 main에서 운영 중이라고 표현하지 않습니다.',
	},
	{
		eyebrow: '검증 범위',
		title: '저장소에 정의된 검증 도구',
		paragraphs: ['웹 저장소에는 lint, build, Playwright 기반 E2E 실행 스크립트가 정의되어 있습니다. 이번 포트폴리오 작업에서는 비공개 애플리케이션의 테스트를 실행하지 않았으므로 통과 여부나 서비스 성과 수치를 주장하지 않습니다.'],
	},
];
---

<PortfolioProjectDetail
	title="Ent-360 Insight Dashboard"
	eyebrow="기업 데이터 통합 분석"
	subtitle="기업 정보와 공시·감사 데이터를 연결해 살펴보는 풀스택 대시보드"
	description="기업 데이터 통합 조회, 통계 집계와 대시보드 시각화를 위해 프런트엔드와 백엔드 연동을 구현한 프로젝트입니다."
	stack={['Next.js', 'React', 'TypeScript', 'Tailwind CSS', 'Python', 'FastAPI', 'Docker']}
	sections={sections}
/>
