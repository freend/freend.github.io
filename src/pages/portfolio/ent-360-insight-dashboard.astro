---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const sections = [
	{
		eyebrow: '서비스',
		title: '기업을 중심으로 여러 정보를 한 화면에',
		paragraphs: [
			'기업 기본정보를 기준으로 재무·고용, 공시와 감사보고서, 특허·벤처 자료를 연결해 탐색할 수 있도록 만들었습니다. 수집 현황과 주요 지표는 통계 대시보드에서 살펴봅니다.',
			'저는 Next.js 화면과 API 연동, 실행 구성을 함께 맡아 데이터 조회에서 시각화까지 이어지는 흐름을 구현했습니다.',
		],
		cards: [
			{ title: '기업 인사이트', body: '기업 프로필을 중심으로 재무·고용 정보를 모아 같은 맥락에서 확인합니다.' },
			{ title: '공시와 보고서', body: '공시·감사보고서와 특허·벤처 정보를 관련 기업 데이터와 함께 탐색합니다.' },
			{ title: '운영 통계', body: '데이터 수집 현황과 도메인별 주요 지표를 대시보드 화면으로 연결합니다.' },
		],
	},
	{
		eyebrow: '서비스 구조',
		title: '웹 화면과 API 사이에 서버 경계를 두다',
		flow: ['Next.js App Router', 'Same-origin API route', 'Next.js Middleware', 'Dashboard API'],
		paragraphs: ['도메인별 페이지와 서비스 모듈이 API 데이터를 받아 표와 통계 화면을 구성합니다. 브라우저는 같은 웹 origin으로 요청하고, 서버 미들웨어가 실행 환경에 맞는 API 대상으로 연결합니다.'],
	},
	{
		eyebrow: '기술적 도전',
		title: '백엔드 연결을 빌드 시점에서 실행 시점으로 이동',
		cards: [
			{ title: '문제', body: '빌드 시점에 백엔드 주소를 rewrites에 고정하면 standalone 웹 결과물과 컨테이너 실행 환경의 설정이 서로 묶였습니다. 브라우저가 다른 origin을 직접 호출하는 구조도 외부 접속 환경에서 CORS와 Private Network Access 제약을 만났습니다.' },
			{ title: '판단과 구현', body: '브라우저는 상대 API 경로를 사용하고, Next.js Middleware가 요청을 서버 측에서 전달하도록 바꿨습니다. 백엔드 대상은 컨테이너 실행 시 환경 설정으로 정해져 빌드 결과와 실행 환경을 분리합니다.' },
		],
	},
	{
		eyebrow: '빌드 경험',
		title: '검색 파라미터를 쓰는 화면의 프리렌더링 문제 해결',
		paragraphs: ['사이드바가 검색 파라미터를 읽는 화면에서 Next.js 프리렌더링이 막혔습니다. 관련 화면을 클라이언트 컴포넌트와 상위 Suspense 경계로 나눠 정적 빌드 경로를 유지했습니다.'],
	},
	{
		eyebrow: '실행 구성',
		title: 'standalone 웹 결과물과 Docker 실행 구성',
		paragraphs: ['Next.js standalone 빌드와 Docker·Compose 구성을 사용해 웹 실행 환경을 구성했습니다. API 주소를 런타임에 연결하도록 분리해 동일한 웹 빌드 결과물을 환경별 설정과 함께 실행할 수 있게 했습니다.'],
	},
];
---

<PortfolioProjectDetail
	title="Ent-360 Insight Dashboard"
	eyebrow="Full-Stack Enterprise Insights"
	subtitle="기업 데이터를 조회에서 분석까지 연결하는 풀스택 대시보드"
	description="기업 정보와 재무·고용, 공시·감사 자료를 통합해 탐색하는 대시보드입니다. 저는 프런트엔드 화면, API 연결, 컨테이너 실행 구성을 함께 구현했습니다."
	stack={['Next.js', 'React', 'TypeScript', 'Tailwind CSS', 'Python', 'FastAPI', 'Docker']}
	sections={sections}
/>
