---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const stack = ['Python', 'FastAPI', 'Selenium', 'Pandas', 'SQLAlchemy', 'aiohttp', 'Open DART API', 'Docker', 'JWT'];
const stackBadges = [
	{ name: 'Python', url: 'https://img.shields.io/badge/Python-3670A0?style=for-the-badge&logo=python&logoColor=ffdd54' },
	{ name: 'FastAPI', url: 'https://img.shields.io/badge/FastAPI-009688?style=for-the-badge&logo=fastapi&logoColor=white' },
	{ name: 'Selenium', url: 'https://img.shields.io/badge/Selenium-43B02A?style=for-the-badge&logo=selenium&logoColor=white' },
	{ name: 'Pandas', url: 'https://img.shields.io/badge/Pandas-150458?style=for-the-badge&logo=pandas&logoColor=white' },
	{ name: 'SQLAlchemy', url: 'https://img.shields.io/badge/SQLAlchemy-D71F00?style=for-the-badge&logo=sqlalchemy&logoColor=white' },
	{ name: 'aiohttp', url: 'https://img.shields.io/badge/aiohttp-2C5BB4?style=for-the-badge&logo=python&logoColor=white' },
	{ name: 'Open DART API', url: 'https://img.shields.io/badge/Open_DART_API-1F3A5F?style=for-the-badge' },
	{ name: 'Docker', url: 'https://img.shields.io/badge/Docker-2496ED?style=for-the-badge&logo=docker&logoColor=white' },
	{ name: 'JWT', url: 'https://img.shields.io/badge/JWT-000000?style=for-the-badge&logo=jsonwebtokens&logoColor=white' },
];

const sections = [
	{
		eyebrow: '01 · WHY',
		title: '데이터 제공 범위에 따라 기업·재무·공시 수집 경로를 분리',
		paragraphs: [
			'Open DART API는 기업 유형과 데이터 항목에 따라 제공 범위가 달랐습니다. API로 제공되는 기업정보·재무정보·공시목록은 API로 수집하고, API에서 제공하지 않는 외감기업의 재무정보와 관련 공시보고서는 DART 공시 페이지에서 찾아 파싱했습니다.',
		],
	},
	{
		eyebrow: '02 · WEB SCRAPING',
		title: 'DART 공시 페이지에서 외감기업 재무정보와 공시보고서 수집',
		paragraphs: [
			'dart-audit-api-server에서는 DART 공시목록에서 외감기업의 재무정보와 관련 공시보고서를 찾아 파싱하는 수집 흐름을 구현했습니다. 정리한 재무정보는 저장한 뒤 조회·집계 API로 제공합니다.',
		],
		flow: ['외감기업 공시목록', '재무정보·공시보고서 확인', 'Selenium 페이지 탐색', '공시 페이지·보고서 HTML·iframe 파싱', 'Pandas 데이터 정리', 'FastAPI·데이터 저장소'],
		bullets: [
			'Selenium으로 DART 공시목록에서 외감기업의 재무정보와 관련 공시보고서를 찾고, 공시 페이지와 보고서 HTML·iframe에서 내용을 파싱합니다.',
			'추출한 값을 Pandas DataFrame으로 정리하고 필수 필드와 날짜 입력을 확인한 뒤 SQLAlchemy 저장 계층에 기록합니다.',
			'저장된 데이터는 FastAPI 조회·집계 엔드포인트로 제공하며, 수집 작업은 BackgroundTasks로 실행하고 Docker 환경에 구성했습니다.',
		],
		note: '담당 범위 · dart-audit-api-server 전체 설계 및 구현 (100%)',
	},
	{
		eyebrow: '03 · OPEN API',
		title: '공식 API 기반 기업정보·재무정보 수집',
		paragraphs: [
			'ai-dart-scraper는 Open DART API가 제공하는 기업의 기업정보·재무정보·공시목록을 수집합니다. 응답을 Pydantic 모델로 처리하고 전처리해 저장 및 조회에 사용할 데이터로 구성합니다.',
			'FastAPI 조회 엔드포인트는 기업·재무 정보를 응답 모델로 제공하며 JWT 토큰을 검증합니다.',
		],
		flow: ['Open DART API', 'aiohttp 비동기 요청', 'Pydantic 응답 모델', '데이터 전처리·저장', 'FastAPI 조회 API'],
		note: '참여 범위 · ai-dart-scraper 일부 기능 개발 (약 10–20%)',
	},
	{
		eyebrow: '04 · ENGINEERING DECISIONS',
		title: 'API 제공 범위에 따라 수집 경로를 구분',
		paragraphs: [
			'Open DART API로 제공되는 기업정보·재무정보·공시목록은 API 응답을 기준으로 처리했습니다. API에서 제공하지 않는 외감기업의 재무정보와 관련 공시보고서는 DART 공시 페이지에서 찾아 파싱하도록 수집 경로를 구분했습니다.',
			'두 방식 모두 정리된 데이터를 저장하고 조회 API로 전달하도록 구성해, 수집 방식과 서비스에서 데이터를 활용하는 흐름을 연결했습니다.',
		],
	},
];
---

<PortfolioProjectDetail
	title="DART Data Collection"
	eyebrow="Data Engineering · Backend"
	subtitle="Open DART API 데이터와 외감기업 재무정보·공시보고서 수집"
	description="Open DART API가 제공하는 기업정보·재무정보·공시목록을 수집하고, API에서 제공하지 않는 외감기업의 재무정보와 관련 공시보고서는 DART 공시 페이지에서 찾아 파싱하는 두 수집 경로를 구성했습니다."
	stack={stack}
	stackBadges={stackBadges}
	sections={sections}
/>
