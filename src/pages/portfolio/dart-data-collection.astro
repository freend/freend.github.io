---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const stack = ['Python', 'FastAPI', 'Selenium', 'Pandas', 'SQLAlchemy', 'aiohttp', 'Open DART API', 'Docker', 'JWT'];
const stackBadges = [
	{ name: 'Python', url: 'https://img.shields.io/badge/Python-3670A0?style=for-the-badge&logo=python&logoColor=ffdd54' },
	{ name: 'FastAPI', url: 'https://img.shields.io/badge/FastAPI-009688?style=for-the-badge&logo=fastapi&logoColor=white' },
	{ name: 'Selenium', url: 'https://img.shields.io/badge/Selenium-43B02A?style=for-the-badge&logo=selenium&logoColor=white' },
	{ name: 'Pandas', url: 'https://img.shields.io/badge/Pandas-150458?style=for-the-badge&logo=pandas&logoColor=white' },
	{ name: 'SQLAlchemy', url: 'https://img.shields.io/badge/SQLAlchemy-D71F00?style=for-the-badge&logo=sqlalchemy&logoColor=white' },
	{ name: 'aiohttp', url: 'https://img.shields.io/badge/aiohttp-2C5BB4?style=for-the-badge&logo=python&logoColor=white' },
	{ name: 'Open DART API', url: 'https://img.shields.io/badge/Open_DART_API-1F3A5F?style=for-the-badge' },
	{ name: 'Docker', url: 'https://img.shields.io/badge/Docker-2496ED?style=for-the-badge&logo=docker&logoColor=white' },
	{ name: 'JWT', url: 'https://img.shields.io/badge/JWT-000000?style=for-the-badge&logo=jsonwebtokens&logoColor=white' },
];

const sections = [
	{
		eyebrow: '01 · WHY',
		title: '수집 대상에 따라 두 방식으로 개발',
		paragraphs: [
			'DART 공식 API에서 데이터를 제공하는 기업의 기업정보·재무정보·공시목록을 수집하는 서비스 개발에 일부 참여했습니다. 별도로, 공식 API에서 데이터를 제공하지 않는 외감기업을 대상으로 DART 홈페이지에서 재무정보와 재무 관련 공시목록을 수집하는 시스템을 설계·구현했습니다.',
		],
	},
	{
		eyebrow: '02 · WEB SCRAPING',
		title: 'API 미제공 외감기업의 재무정보를 홈페이지에서 수집',
		paragraphs: [
			'DART 공식 API에서 데이터를 제공하지 않는 외감기업을 대상으로, 홈페이지 공시목록에서 재무 관련 보고서를 확인·선별했습니다. 선택한 보고서를 직접 크롤링해 재무정보를 추출하고 서비스에서 활용할 수 있도록 구조화했습니다.',
		],
		flow: ['외감기업 공시목록', '재무 관련 보고서 선별', 'Selenium 페이지 탐색', 'HTML·iframe 표 파싱', 'Pandas 데이터 정리', 'FastAPI·데이터 저장소'],
		bullets: [
			'Selenium으로 DART 공시목록을 탐색해 재무 관련 보고서를 선별한 뒤 해당 보고서로 이동합니다.',
			'보고서 HTML과 iframe 표에서 재무정보를 추출해 Pandas DataFrame으로 정리합니다.',
			'필수 필드와 날짜 입력을 확인한 뒤 SQLAlchemy 기반 저장 계층에 기록하고, FastAPI 조회·집계 엔드포인트로 제공합니다.',
			'재무정보 수집을 FastAPI BackgroundTasks로 실행할 수 있도록 구성하고 Docker 실행 환경을 마련했습니다.',
		],
		note: 'dart-audit-api-server 전체 설계 및 구현을 담당했습니다(100%).',
	},
	{
		eyebrow: '03 · OPEN API',
		title: 'Open DART API가 제공하는 기업정보·재무정보 수집',
		paragraphs: [
			'Open DART API에서 데이터를 제공하는 기업을 대상으로 기업정보, 재무정보, 공시목록을 수집합니다. aiohttp 비동기 요청으로 응답을 받고 Pydantic 모델과 전처리 단계를 거쳐 저장·조회에 사용할 데이터로 변환합니다.',
			'FastAPI는 기업 및 재무 정보 조회 응답을 모델로 관리하며, 해당 조회 엔드포인트에는 JWT 토큰 검증이 적용되어 있습니다. 이 서비스의 일부 기능 개발에 참여했습니다.',
		],
		flow: ['Open DART API', 'aiohttp 비동기 요청', 'Pydantic 응답 모델', '데이터 전처리·저장', 'FastAPI 조회 API'],
		note: 'ai-dart-scraper 일부 기능 개발에 참여했습니다(약 10–20%).',
	},
	{
		eyebrow: '04 · APPROACH',
		title: '수집 대상에 맞춰 각 프로젝트에서 다른 방식을 사용',
		paragraphs: ['두 수집 방식은 각기 다른 대상을 위한 별도 프로젝트로 구현했습니다.'],
		cards: [
			{ title: 'DART 홈페이지 크롤링', body: '대상은 공식 API에서 데이터를 제공하지 않는 외감기업입니다. 공시목록에서 재무 관련 보고서를 선별하고 HTML에서 재무정보를 추출·구조화합니다.' },
			{ title: 'Open DART API', body: '대상은 공식 API에서 데이터를 제공하는 기업입니다. 기업정보·재무정보·공시목록을 API로 수집해 응답 데이터를 처리합니다.' },
		],
	},
	{
		eyebrow: '05 · SCOPE',
		title: '각 프로젝트에서 맡은 범위',
		bullets: [
			'dart-audit-api-server: API 미제공 외감기업의 재무정보와 재무 관련 공시목록 수집 시스템 전체 설계 및 구현 (100%)',
			'ai-dart-scraper: Open DART API 제공 기업의 기업정보·재무정보·공시목록 수집 서비스 일부 기능 개발 참여 (약 10–20%)',
		],
		note: '두 원본 저장소는 비공개이므로 공개 소스 링크를 제공하지 않습니다. 내부 주소, 인증 정보, 기업 데이터와 회사 전용 스키마는 포트폴리오에 포함하지 않았습니다.',
	},
];
---

<PortfolioProjectDetail
	title="DART Data Collection"
	eyebrow="Data Engineering · Backend"
	subtitle="API 제공 기업 정보 수집과 외감기업 재무정보 크롤링"
	description="Open DART API 제공 기업의 기업정보·재무정보·공시목록을 수집하는 서비스 개발에 일부 참여하고, API 미제공 외감기업의 재무정보와 재무 관련 공시목록을 수집하는 별도 크롤링 시스템을 설계·구현했습니다."
	stack={stack}
	stackBadges={stackBadges}
	sections={sections}
/>
