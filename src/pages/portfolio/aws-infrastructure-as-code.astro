---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const stack = ['Terraform', 'AWS', 'CodePipeline', 'CodeBuild', 'Amazon ECR', 'IAM'];
const stackBadges = [
	{ name: 'Terraform', url: 'https://img.shields.io/badge/Terraform-7B42BC?style=for-the-badge&logo=terraform&logoColor=white' },
	{ name: 'AWS', url: 'https://img.shields.io/badge/AWS-232F3E?style=for-the-badge&logo=amazonaws&logoColor=white' },
	{ name: 'CodePipeline', url: 'https://img.shields.io/badge/CodePipeline-232F3E?style=for-the-badge&logo=amazonaws&logoColor=white' },
	{ name: 'CodeBuild', url: 'https://img.shields.io/badge/CodeBuild-232F3E?style=for-the-badge&logo=amazonaws&logoColor=white' },
	{ name: 'Amazon ECR', url: 'https://img.shields.io/badge/Amazon_ECR-232F3E?style=for-the-badge&logo=amazonaws&logoColor=white' },
	{ name: 'IAM', url: 'https://img.shields.io/badge/IAM-232F3E?style=for-the-badge&logo=amazonaws&logoColor=white' },
];

const resourceTable = {
	caption: 'Terraform으로 구성·관리한 AWS 리소스',
	headers: ['영역', 'AWS 리소스', '관리 내용'],
	rows: [
		['CI/CD 및 배포', 'AWS CodePipeline · AWS CodeBuild · Amazon ECR Repository · ECR Lifecycle Policy · ECR Repository Policy · AWS Amplify', '서비스별 소스·빌드·배포 단계와 빌드 프로젝트, 컨테이너 이미지 저장·수명 주기·접근 정책, 앱·브랜치·도메인 연결'],
		['컴퓨팅 및 API', 'Amazon EC2 · AWS Lambda · Amazon API Gateway', '인스턴스와 연결 리소스, 함수 실행 구성, REST API 리소스·메서드·통합·스테이지'],
		['데이터 저장 및 메시징', 'Amazon DocumentDB · Amazon ElastiCache for Redis · Amazon DynamoDB · Amazon RDS for MariaDB · Amazon S3 · Amazon SQS', '클러스터와 인스턴스, 복제 그룹과 1개 멤버 노드 (aws_elasticache_replication_group), 운영 테이블 3개 (aws_dynamodb_table), MariaDB DB 인스턴스 (aws_db_instance), 버킷·접근 설정, 큐·접근 정책'],
		['네트워크 및 접근 제어', 'Amazon Route 53 · Amazon EC2 Security Groups · AWS IAM Users · AWS IAM Roles · AWS IAM Policies', 'DNS 호스팅 영역·레코드, 인바운드·아웃바운드 규칙, 사용자·서비스 역할과 권한 정책'],
		['운영 및 구성', 'Amazon EventBridge · Systems Manager Parameter Store', '이벤트 규칙·대상 연결과 애플리케이션 파라미터'],
	],
};

const sections = [
	{
		eyebrow: '01 · 관리 방식 개선',
		title: '반복적인 AWS 인프라 관리를 Terraform 코드 기반으로 전환',
		cards: [
			{ title: '관리 방식 개선', body: '콘솔 중심에서 Terraform 코드 기반으로 전환했습니다. 반복적인 인프라 설정과 변경 작업을 코드로 정의하고 관리했습니다.' },
			{ title: '적용 범위', body: '기존 AWS 리소스 약 320개를 Terraform 코드와 State에 연결해 관리 대상으로 편입했습니다.' },
		],
	},
	{
		eyebrow: '02 · WHY',
		title: '반복적인 AWS 콘솔 설정을 코드로 관리하기 시작',
		paragraphs: [
			'회사에서 CI/CD와 AWS 리소스를 구성·관리하며 콘솔에서 반복해서 설정하는 작업이 많았습니다. 반복 작업을 줄일 방법을 찾다가 Terraform을 도입했고, 필요한 인프라를 코드로 선언하고 관리하는 방식으로 발전시켰습니다.',
		],
	},
	{
		eyebrow: '03 · 클라우드 비용 대응',
		title: '구축 비용 문제에 기술적 대안 적용',
		paragraphs: [
			'전사 인프라와 클라우드 비용을 관리하며 수천만 원 규모의 구축 비용 문제를 기술적 대안으로 해결한 경험이 있습니다.',
		],
	},
	{
		eyebrow: '04 · HOW',
		title: 'AWS 인프라를 설계·구축·운영하고 Terraform으로 관리',
		paragraphs: [
			'서비스와 배포 정책에 필요한 AWS 인프라를 직접 설계·구축·운영했습니다. Terraform 코드로 리소스를 정의하고 변경을 적용하며, 구성과 State 변화를 확인해 관리했습니다.',
			'CodePipeline·CodeBuild·ECR을 빌드와 컨테이너 이미지 관리에 활용하고, 컴퓨팅·데이터 저장·메시징·네트워크·접근 제어 등 서비스 운영에 필요한 리소스를 구성했습니다. 아래 표에 역할별 범위를 정리했습니다.',
		],
		flow: ['Terraform 코드', 'AWS 리소스 구성', '변경 적용 및 State 확인'],
		table: resourceTable,
	},
	{
		eyebrow: '05 · ENGINEERING DECISIONS',
			title: '코드와 State를 함께 살피며 인프라 변경 관리',
		paragraphs: [
			'Terraform 코드에 선언한 구성과 State의 변화를 함께 확인하며 인프라를 관리했습니다. 기존 리소스의 관리 전환 후 최종 terraform plan에서 추가·변경·삭제 예정 항목이 없음을 확인했습니다.',
		],
	},
];
---

<PortfolioProjectDetail
	title="AWS Infrastructure as Code"
	eyebrow="직접 설계·구축·관리 · Cloud Infrastructure"
	subtitle="AWS 인프라 설계·운영과 Terraform 기반 관리"
	description="서비스와 배포 정책에 맞는 AWS 인프라를 직접 설계·구축·운영했습니다. 반복 설정을 Terraform 코드로 관리하며, 기존 리소스의 관리 전환과 최종 plan 검증도 수행했습니다."
	stack={stack}
	stackBadges={stackBadges}
	sections={sections}
	relatedLinks={[{ label: 'Kubernetes Platform Engineering', href: '/portfolio/kubernetes-platform-engineering' }]}
/>
