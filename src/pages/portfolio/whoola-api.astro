---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const sections = [
	{
		eyebrow: 'Domain API',
		title: '회원·상품·구매 흐름을 API로 구현',
		paragraphs: ['Whoola API는 회원 인증과 정보, 상품 조회, 구매 처리를 담당하는 Java 백엔드입니다. 저는 화면 렌더링 서버와 분리된 REST API와 도메인별 서비스 로직을 구현했습니다.'],
		bullets: [
			'회원 가입·로그인·정보 조회와 비밀번호 변경',
			'상품 목록·상세 조회와 서비스별 상품 탐색',
			'구매 생성, 구매 내역과 사용자별 구매 조회',
			'페이지 단위로 나누어 제공하는 회원·상품·구매 목록',
		],
	},
	{
		eyebrow: '서비스 계층',
		title: '도메인 규칙과 영속성의 경계를 분리',
		cards: [
			{ title: 'Controller', body: 'Spring Web 컨트롤러가 도메인별 HTTP 요청과 응답을 맡습니다.' },
			{ title: 'Service', body: '서비스 계층이 회원·상품·구매 흐름을 조정하며 쓰기 작업은 트랜잭션 경계 안에서 처리합니다.' },
			{ title: 'JPA Data Access', body: '엔티티와 데이터 접근 계층으로 조회 및 변경을 분리하고, 목록 API에는 pageable 결과를 사용합니다.' },
		],
	},
	{
		eyebrow: '인증과 연결 구조',
		title: '자격 확인부터 Renderer 연동까지',
		flow: ['Renderer HTTP request', 'Spring Web Controller', 'Domain Service', 'JPA Repository'],
		paragraphs: ['로그인 과정에서 password encoder로 비밀번호를 확인하고, 인증에 성공하면 사용자 권한을 담은 JWT를 발급합니다. Renderer는 별도 HTTP 요청으로 API 결과를 받아 EJS 화면을 완성합니다.'],
	},
	{
		eyebrow: '기술적 경험',
		title: '요청 처리와 도메인 쓰기를 하나의 흐름으로',
		paragraphs: ['구매 처리는 회원과 상품을 확인하고 결과를 남기는 서비스 작업으로 구성했습니다. 트랜잭션 경계를 서비스 계층에 두고, 컨트롤러·서비스·데이터 접근 계층의 책임을 나눠 HTTP 처리와 도메인 변경을 분리했습니다. Java 8 기반 Spring Boot에서 REST, JPA 영속성, Spring Security/JWT 인증을 함께 다룬 프로젝트입니다.'],
	},
];
---

<PortfolioProjectDetail
	title="Whoola API"
	eyebrow="Backend Engineering · Java"
	subtitle="Spring Boot로 회원·상품·구매 도메인을 구현한 API"
	description="저는 Whoola Renderer와 분리된 REST API를 만들고, Spring 서비스 계층에서 도메인 로직과 데이터 접근을 연결했습니다."
	stack={['Java', 'Spring Boot', 'Spring Web', 'Spring Data JPA', 'Spring Security', 'JWT', 'Gradle']}
	sections={sections}
/>
