---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const stack = ['Python', 'FastAPI', 'SQLAlchemy', 'pandas', 'APScheduler', 'Docker', 'pytest'];

const stackBadges = [
	{
		name: 'Python',
		url: 'https://img.shields.io/badge/python-3670A0?style=for-the-badge&logo=python&logoColor=ffdd54',
	},
	{
		name: 'FastAPI',
		url: 'https://img.shields.io/badge/FastAPI-009688?style=for-the-badge&logo=fastapi&logoColor=white',
	},
	{
		name: 'SQLAlchemy',
		url: 'https://img.shields.io/badge/SQLAlchemy-D71F00?style=for-the-badge&logo=sqlalchemy&logoColor=white',
	},
	{
		name: 'pandas',
		url: 'https://img.shields.io/badge/pandas-150458?style=for-the-badge&logo=pandas&logoColor=white',
	},
	{
		name: 'APScheduler',
		url: 'https://img.shields.io/badge/APScheduler-2C3E50?style=for-the-badge&logo=python&logoColor=white',
	},
	{
		name: 'Docker',
		url: 'https://img.shields.io/badge/Docker-2496ED?style=for-the-badge&logo=docker&logoColor=white',
	},
	{
		name: 'pytest',
		url: 'https://img.shields.io/badge/pytest-0A9EDC?style=for-the-badge&logo=pytest&logoColor=white',
	},
];

const sections = [
	{
		eyebrow: '01 · 문제와 해결 방식',
		title: '분산된 수집 통계를 대시보드용 API로 통합',
		paragraphs: [
			'여러 데이터 수집 시스템이 각자 데이터를 저장하고 있었지만, 전체 수집 결과와 기간별 추세를 함께 보는 화면은 없었습니다. 수집 현황을 파악하려면 도메인별 저장소를 따로 조회하고 결과를 모아야 했습니다.',
			'원천 데이터를 한곳으로 옮기지 않고 각 저장소의 통계를 조회해 하나의 API 응답으로 조합했습니다. 대시보드는 이 공통 응답으로 도메인별 수집 현황과 추이를 보여줍니다.',
		],
		cards: [
			{
				title: 'BEFORE · 개별 확인',
				body: '도메인별 저장소 개별 조회 → 수집 현황과 추세를 따로 취합',
			},
			{
				title: 'AFTER · 통합 조회',
				body: '각 저장소의 통계 조회 → 통합 API 응답 구성 → 대시보드 표시',
			},
		],
		note: '원천 데이터는 도메인별 저장소에 두고, 대시보드에서 사용할 통계 응답을 API에서 통합했습니다.',
	},
	{
		eyebrow: '02 · 시스템 아키텍처',
		title: '요청부터 저장소 집계까지 책임을 나눴습니다',
		paragraphs: [
			'FastAPI Router가 요청을 받고 사용자 인증과 응답 모델을 적용합니다. StatsService는 통계 API의 진입점이며, DashboardService는 대시보드 응답에 필요한 도메인 통계를 조회하고 조합합니다.',
			'도메인 Service는 각 영역의 조회를 연결하고 Repository는 AsyncSession과 SQLAlchemy 쿼리로 저장소에서 집계값을 가져옵니다. 저장소 접근은 도메인별로 유지하면서 API 응답 구성은 대시보드 서비스에 모았습니다.',
		],
		flow: ['FastAPI Router', 'StatsService', 'DashboardService', '도메인 Service', 'Repository', 'Async SQLAlchemy', '도메인별 저장소'],
		note: '이 계층 흐름은 개발 브랜치에서 확인한 구현을 기준으로 합니다.',
	},
	{
		eyebrow: '03 · 도메인별 통계 통합',
		title: '병렬로 조회한 통계를 대시보드 응답으로 조합합니다',
		paragraphs: [
			'DashboardService는 기업·특허·논문·공시·재무 등 도메인 Service를 asyncio.gather로 병렬 조회하고, 결과를 요약 통계와 기간별 추이 응답으로 조합합니다.',
			'재무 통계는 기업·DART·외감기업·벤처 원천에서 조회한 집계값을 합산합니다. 웹 대시보드는 저장소별 구조를 알 필요 없이 통합 API에서 요약과 추이를 가져옵니다.',
		],
		flow: ['도메인별 통계 조회', 'asyncio.gather 병렬 조율', '결과 통합', '요약·추세 API 응답', '수집 현황 대시보드'],
	},
	{
		eyebrow: '04 · 누적 추이 역산 · Recursive Inverse Calculation',
		title: '기간별 증분과 최신 총계로 과거 누적값을 계산합니다',
		paragraphs: [
			'누적 추이에는 최신 총계와 날짜별 증분이 필요합니다. 최신 시점의 누적값에서 각 기간의 증분을 역순으로 빼면 이전 시점의 누적값을 구할 수 있어, 약 9,000만 건 규모의 과거 데이터 전체를 매번 COUNT하지 않고 추이를 구성합니다.',
			'기업·특허·논문·공시·벤처·주식 및 시장 데이터·뉴스·고용·재무의 9개 영역을 집계합니다. 증가형 PK를 사용하는 대상은 최대 ID와 전일 마지막 ID의 차이로 신규량을 계산합니다.',
		],
		formula: 'P[i-1] = P[i] - D[i]',
		code: {
			language: 'python',
			content: `def calculate_cumulative_trends(type_data, total_counts):
    result_map = {}
    for cat in target_categories:
        current_total = total_counts.get(cat, 0)
        for label in reversed(labels):
            delta = find_delta(label, cat)
            result_map[(label, cat)] = current_total
            current_total -= delta
    return result_map`,
		},
	},
	{
		eyebrow: '05 · 데이터 최신성과 캐시',
		title: '전체 집계 재사용과 당일 증분 갱신을 분리합니다',
		paragraphs: [
			'일일 전체 갱신은 도메인별 누적 통계를 캐시에 저장합니다. 시간별 작업은 today_only 결과만 조회해 기존 누적·전일 값과 합치므로, 과거 통계 재사용과 오늘 수집량 반영을 나눠 처리합니다.',
			'대시보드 요약 스냅샷은 4,000초 TTL을 사용합니다. 기본 MemoryCacheAdapter는 만료 시각을 관리하고, 테스트에서는 NoOpCacheAdapter로 캐시를 우회해 miss 경로를 확인합니다.',
		],
		flow: ['일일 전체 집계', '누적 통계 캐시', '시간별 today_only 조회', '당일 결과 병합', '대시보드 응답'],
	},
	{
		eyebrow: '06 · API 응답 시간 비교',
		title: 'cache miss와 cache hit의 Summary API 응답을 비교했습니다',
		paragraphs: [
			'동일한 서버 프로세스에서 연속 호출한 로그를 비교했습니다. 첫 요청은 cache miss로 DB COUNT를 실행했고, 다음 cache hit는 같은 total을 반환하면서 COUNT를 다시 실행하지 않았습니다. 표에는 전체 API 응답 시간과 DB COUNT 시간을 함께 적었습니다.',
			'아래 값은 cache miss와 다음 cache hit를 각각 한 번 측정한 기록입니다. 별도로 클라이언트에서 감사·재무 요약 API를 비교한 한 쌍의 요청은 7.676379초와 0.002402초였으며, 두 응답 내용은 같았습니다.',
		],
		table: {
			caption: '애플리케이션 로그 기준 Summary API 응답 시간',
			headers: ['API', '응답 total', '최초 조회 · cache miss', '캐시 재사용 · cache hit', '응답 시간 단축률'],
			rows: [
				['기업 요약', '1,517,359', '1.5454초 (DB COUNT 1.5335초)', '약 0.001초 (DB COUNT 미실행)', '약 99.94%'],
				['감사·재무 요약', '35,324,535', '7.6747초 (DB COUNT 7.6626초)', '약 0.002초 (DB COUNT 미실행)', '약 99.97%'],
			],
		},
	},
	{
		eyebrow: '07 · 테스트 및 검증',
		title: '캐시 경계 동작과 통계 API 응답을 확인했습니다',
		paragraphs: [
			'pytest 단위 테스트는 메모리 캐시의 기본 동작과 TTL 만료, 기존 누적값을 보존하면서 당일 통계를 병합하는 로직, 대시보드 요약의 cache hit/miss를 확인합니다. HTTPX AsyncClient 통합 테스트는 통계 API의 응답 상태와 필드를 검사합니다.',
			'개발 브랜치의 선택 테스트 기록은 8개 통과, 2개 실패입니다. 실패 항목은 반환 데이터 구조와 audit 캐시 상태에 대한 기대 차이로 기록되어 있습니다.',
		],
	},
];
---

<PortfolioProjectDetail
	title="Collect Dashboard API"
	eyebrow="Backend Engineering · Data Systems"
	subtitle="분산된 수집 현황을 통합 조회하는 통계 백엔드"
	description="여러 데이터 수집 시스템과 저장소의 현황을 통합해, 도메인별 수집 결과와 누적 추세를 대시보드에서 확인할 수 있도록 개발한 통계 API입니다."
	stack={stack}
	stackBadges={stackBadges}
	sections={sections}
	relatedLinks={[{ label: 'Ent-360 수집 통계 대시보드', href: '/portfolio/ent-360-insight-dashboard' }]}
/>
