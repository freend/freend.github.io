---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const stack = ['Python', 'FastAPI', 'SQLAlchemy', 'pandas', 'APScheduler', 'Docker', 'pytest'];

const stackBadges = [
	{
		name: 'Python',
		url: 'https://img.shields.io/badge/python-3670A0?style=for-the-badge&logo=python&logoColor=ffdd54',
	},
	{
		name: 'FastAPI',
		url: 'https://img.shields.io/badge/FastAPI-009688?style=for-the-badge&logo=fastapi&logoColor=white',
	},
	{
		name: 'SQLAlchemy',
		url: 'https://img.shields.io/badge/SQLAlchemy-D71F00?style=for-the-badge&logo=sqlalchemy&logoColor=white',
	},
	{
		name: 'pandas',
		url: 'https://img.shields.io/badge/pandas-150458?style=for-the-badge&logo=pandas&logoColor=white',
	},
	{
		name: 'APScheduler',
		url: 'https://img.shields.io/badge/APScheduler-2C3E50?style=for-the-badge&logo=python&logoColor=white',
	},
	{
		name: 'Docker',
		url: 'https://img.shields.io/badge/Docker-2496ED?style=for-the-badge&logo=docker&logoColor=white',
	},
	{
		name: 'pytest',
		url: 'https://img.shields.io/badge/pytest-0A9EDC?style=for-the-badge&logo=pytest&logoColor=white',
	},
];

const sections = [
	{
		eyebrow: '01 · API 아키텍처',
		title: '요청 계약과 도메인 집계를 분리했습니다',
		paragraphs: [
			'대시보드 요약과 기간별 추세를 FastAPI 라우터로 제공하고, Pydantic 응답 모델로 반환 구조를 정했습니다. 요청은 통계 서비스의 파사드를 거쳐 대시보드 서비스에 도달합니다.',
			'대시보드 서비스는 기업·특허·논문·공시·재무 등 각 도메인 서비스의 결과를 비동기로 모읍니다. Repository는 비동기 SQLAlchemy 세션으로 집계 SQL을 실행하고, 서비스는 도메인별 결과와 재무 원천별 통계를 하나의 응답으로 조립합니다.',
		],
		flow: ['FastAPI Router', 'StatsService', 'DashboardService', '도메인 Service · Repository', 'Async SQLAlchemy'],
		cards: [
			{
				title: 'Router · 응답 계약',
				body: '요약과 추세 엔드포인트에서 인증 의존성과 Pydantic response model을 적용해 API 입력과 출력의 경계를 둡니다.',
			},
			{
				title: 'Service · 집계 조율',
				body: 'DashboardService가 asyncio.gather로 도메인 조회를 병렬 실행하고, 재무 통계는 여러 원천의 합으로 조립합니다.',
			},
			{
				title: 'Repository · 데이터 접근',
				body: '도메인별 Repository가 AsyncSession과 SQLAlchemy text 쿼리로 합계와 기간별 증가량을 조회합니다.',
			},
			{
				title: '부분 실패 처리',
				body: '한 도메인의 조회가 실패해도 예외를 기록하고 해당 결과를 기본값으로 채워 나머지 통계를 응답에 담습니다.',
			},
		],
	},
	{
		eyebrow: '02 · 집계와 캐시',
		title: '전체 건수는 재사용하고 당일 변화량은 따로 갱신합니다',
		paragraphs: [
			'전체 행 수를 매번 다시 세는 비용을 줄이기 위해 도메인별 전체 통계와 대시보드 응답을 캐시에 보관합니다. 캐시가 없는 도메인에는 include_total을 켜 전체 건수를 다시 계산하고, 캐시가 있으면 전체 값은 재사용하면서 오늘·어제 수치를 조회합니다.',
			'APScheduler의 일일 전체 갱신과 시간별 today_only 갱신은 서로 다른 비용의 작업으로 나뉩니다. 시간별 경로에서는 오늘의 집계 결과를 캐시된 전체·전일 값과 병합합니다. 통계 TTL은 설정으로 관리하고, 대시보드 요약 스냅샷은 4,000초, 추세 캐시는 기간 유형과 range_val을 키에 포함합니다.',
		],
		cards: [
			{
				title: 'Cache-aside 조회',
				body: '요약 캐시가 유효하면 바로 반환하고, 누락되거나 필수 도메인이 빠졌을 때만 조회 결과를 다시 조립합니다.',
			},
			{
				title: '전체 집계와 증분 갱신',
				body: '전체 건수는 전체 갱신 또는 캐시 미스에서 계산하고, 주기적 갱신은 today_only 결과를 기존 누적값과 합칩니다.',
			},
			{
				title: '프로세스 메모리 캐시',
				body: 'TTL 만료를 적용한 MemoryCacheAdapter를 사용합니다. 테스트에서는 NoOpCacheAdapter로 캐시 영향을 분리합니다.',
			},
		],
	},
	{
		eyebrow: '03 · 데이터 정합성',
		title: '누적 추세의 기준 총량이 0이 되던 원인을 수정했습니다',
		paragraphs: [
			'누적 추세는 최신 총량을 마지막 시점의 기준값으로 두고, 기간별 증가량을 뒤에서 앞으로 차감해 과거 값을 계산합니다. 논문 통계에서 캐시를 저장할 때는 paper를, 읽을 때는 papers를 사용해 서로 다른 키를 조회하고 있었습니다. 이 불일치로 기준 총량을 가져오지 못하면 역산 결과가 음수로 내려갈 수 있었습니다.',
			'캐시 키를 papers로 통일하고, 캐시 미스에서는 전체 집계를 요청하도록 조회 경로를 맞췄습니다. 병합 시 새 DB 조회에 유효한 전체·전일 값이 있으면 이를 우선하고, 오늘 값은 새 당일 집계로 갱신합니다.',
		],
		flow: ['기간별 증가량', '최신 총량을 기준값으로 설정', '과거 방향으로 증가량 차감', '시간순 누적 추세'],
		note: '누적 추세 수정과 캐시 개선은 개발 브랜치에서 진행한 작업입니다. 현재 main에 반영된 기능과 구분해 소개합니다.',
	},
	{
		eyebrow: '04 · 테스트와 검증',
		title: '캐시 경계와 응답 계약을 나눠 검증합니다',
		paragraphs: [
			'pytest 단위 테스트는 메모리 캐시의 TTL 만료, 기간 범위 포맷, 대시보드 요약의 캐시 hit/miss를 다룹니다. 통합 테스트는 HTTPX AsyncClient와 대체 서비스로 통계 API의 응답 상태와 필드를 확인합니다.',
			'개발 브랜치에서 관련 테스트 10개를 실행했을 때 8개가 통과하고 2개가 실패했습니다. 실패한 테스트는 현재 구현이 평탄한 통계를 반환하는데 중첩된 stats 구조를 기대하거나, 이미 캐시 키가 있는 audit 도메인을 cache miss로 예상합니다. 누적 추세 음수 오류를 직접 고정하는 회귀 테스트는 아직 없습니다.',
		],
		bullets: [
			'TTL 만료와 기간 포맷 단위 테스트: 통과',
			'캐시 병합 및 요약 cache-hit 테스트: 현재 구현과 테스트 기대값 불일치',
			'누적 추세 음수 회귀 시나리오: 전용 테스트 보강 필요',
		],
	},
	{
		eyebrow: '05 · 기술 선택',
		title: '각 기술을 데이터 조회와 운영 갱신의 경계에 배치했습니다',
		cards: [
			{
				title: 'FastAPI · Pydantic',
				body: '비동기 통계 엔드포인트와 요청별 응답 모델을 정의합니다.',
			},
			{
				title: 'SQLAlchemy AsyncSession',
				body: 'Repository에서 비동기 세션을 관리하고 SQL 기반 집계를 실행합니다.',
			},
			{
				title: 'asyncio',
				body: '서로 다른 데이터 도메인의 조회를 동시에 실행해 통합 응답을 구성합니다.',
			},
			{
				title: 'APScheduler · Docker',
				body: '전체·증분 통계 갱신 작업을 예약하고 API 실행 환경을 컨테이너로 구성합니다.',
			},
			{
				title: 'pandas',
				body: '기업 데이터 변환 과정에서 NaN과 무한대 값을 처리합니다.',
			},
			{
				title: 'pytest',
				body: '캐시 경계, 기간 포맷, API 응답을 단위·통합 테스트로 확인합니다.',
			},
		],
	},
];
---

<PortfolioProjectDetail
	title="Collect Dashboard API"
	eyebrow="Backend Engineering · Data Systems"
	subtitle="여러 데이터 도메인의 통계를 하나의 응답 계약으로 통합하는 FastAPI 백엔드"
	description="비동기 조회, 집계 캐시, 시계열 정합성을 함께 설계하며 기업·특허·논문·공시·재무 데이터를 대시보드 API로 연결했습니다."
	stack={stack}
	stackBadges={stackBadges}
	sections={sections}
/>
