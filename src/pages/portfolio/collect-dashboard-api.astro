---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const sections = [
	{
		eyebrow: '개요와 해결하려던 문제',
		title: '대시보드에 필요한 통계 API',
		paragraphs: [
			'기업 데이터 수집 결과를 요약하고 추세로 제공하기 위한 Python 백엔드 API입니다. 개별 조회 결과를 화면에서 조립하는 대신, 요약과 통계 조회를 API 책임으로 구성하는 개발 작업을 다룹니다.',
			'이 프로젝트는 Ent-360 대시보드의 전체 내용을 반복하지 않고, API 설계와 통계 데이터 처리에 초점을 둡니다.',
		],
	},
	{
		eyebrow: '주요 기능',
		title: '요약, 추세, 캐시 처리',
		bullets: [
			'대시보드 요약과 통계 추세 데이터를 제공하는 API 라우터가 있습니다.',
			'기업·재무·고용 통계를 위한 집계 및 추세 조회 코드가 확인됩니다.',
			'TTL 기반 캐시 인터페이스와 메모리 및 비활성(No-op) 어댑터가 구현되어 있습니다.',
			'당일 데이터를 기존 통계와 병합하는 캐시 처리 로직과 관련 테스트 코드가 있습니다.',
		],
	},
	{
		eyebrow: '아키텍처와 핵심 구현',
		title: '라우터, 집계, 캐시 책임을 나눠 구성',
		cards: [
			{ title: 'API 계층', body: 'FastAPI 라우터가 대시보드 요약과 추세 조회 요청을 받습니다.' },
			{ title: '통계 처리', body: '저장소 계층에서 기업 및 관련 통계 데이터를 조회·집계하고 대시보드에 필요한 형식으로 반환합니다.' },
			{ title: '캐시 경계', body: '캐시 인터페이스와 메모리·비활성 구현을 분리해 캐시 사용 여부와 동작을 구분합니다. 수치로 확인된 성능 개선은 제시하지 않습니다.' },
		],
	},
	{
		eyebrow: '기술적 의사결정',
		title: '성능 개선은 구조와 검증 근거를 함께 봅니다',
		paragraphs: ['TTL, 오늘 통계 병합 등 캐시 처리 코드가 확인되지만, 이 정보만으로 개선 폭이나 응답 시간 변화를 일반화할 수는 없습니다. 따라서 성능 수치 대신 구현 경계와 테스트 대상으로 확인된 동작을 소개합니다.'],
	},
	{
		eyebrow: '검증 결과와 범위',
		title: '브랜치 상태와 테스트 범위를 분리',
		paragraphs: ['main과 통계 최적화 개발 브랜치를 비교했습니다. 현재 확인한 통계·캐시 구현과 pytest 테스트는 개발 브랜치에 있으며, 해당 브랜치는 main에 병합된 상태가 아닙니다. 이 상세 내용은 개발 브랜치에서 확인한 구현을 설명하며 main 운영 기능으로 주장하지 않습니다.', '테스트 코드에는 캐시 기본 동작과 TTL, 당일 통계 병합, 대시보드 요약 및 추세 형식 검증이 포함되어 있습니다. 이 포트폴리오 작업에서는 해당 테스트를 실행하지 않았으므로 통과 결과를 표시하지 않습니다.'],
		note: '소스 저장소는 비공개이며 GitHub 코드 링크, 내부 주소, 데이터 연결 설정은 제공하지 않습니다.',
	},
];
---

<PortfolioProjectDetail
	title="Collect Dashboard API"
	eyebrow="백엔드 API와 통계 처리"
	subtitle="기업 통계를 조회하고 대시보드용 요약 데이터를 구성하는 API"
	description="API 계층, 데이터 집계, TTL 캐시 구현을 중심으로 백엔드 개발 경험을 소개합니다."
	stack={['Python', 'FastAPI', 'SQLAlchemy', 'pandas', 'APScheduler', 'Docker', 'pytest']}
	sections={sections}
/>
