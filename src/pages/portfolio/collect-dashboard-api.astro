---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const sections = [
	{
		eyebrow: '백엔드 설계',
		title: '10개 데이터 도메인의 통계를 하나의 API 계약으로',
		paragraphs: [
			'기업·재무·고용·뉴스 등 데이터 도메인마다 달랐던 집계를 대시보드 요약과 추세 API로 연결했습니다. 도메인별 데이터 접근 계층에서 집계를 맡고 서비스 계층에서 공통 조회 흐름과 응답을 조정합니다.',
			'기간 필터를 받아 누적 및 유형별 추세를 반환하도록 API를 구성해 프런트엔드가 도메인별 계산을 반복하지 않게 했습니다.',
		],
		cards: [
			{ title: '도메인 쿼리', body: '각 데이터 영역의 통계 조회를 데이터 접근 계층에 두고 통합 집계에 필요한 결과를 모읍니다.' },
			{ title: '통계 서비스', body: '대시보드 요약과 기간별 누적·유형별 추세 조회를 공통 서비스 흐름으로 제공합니다.' },
		],
	},
	{
		eyebrow: '캐시와 데이터 최신성',
		title: '과거 집계는 재사용하고 오늘 데이터는 최신 값으로 병합',
		paragraphs: ['도메인 통계에 TTL을 적용하고, 메모리 캐시와 비활성 캐시가 같은 계약을 따르도록 구성했습니다. 오늘 통계를 기존 누적·전일 집계값과 병합할 때는 최신 DB 값을 우선해, 오래된 캐시가 당일 집계를 덮지 않게 했습니다.'],
		bullets: [
			'캐시 hit/miss와 TTL을 독립적으로 다루는 캐시 계약',
			'메모리 캐시와 No-op 캐시 구현',
			'도메인별 통계 TTL 설정과 오늘 데이터 병합',
		],
	},
	{
		eyebrow: '데이터 무결성',
		title: '누적 추세가 거꾸로 내려가던 원인을 바로잡다',
		paragraphs: ['논문 통계의 누적 그래프가 새 구간에서 하락하는 문제를 수정했습니다. 도메인마다 달랐던 캐시 식별과 통계 필드 매핑을 맞추고, 병합 시 최신 집계를 우선하도록 정리해 시계열의 기준값이 흔들리지 않게 했습니다.'],
	},
	{
		eyebrow: '검증 가능한 계약',
		title: '캐시와 응답 경계에 테스트를 붙이다',
		paragraphs: ['TTL 만료와 당일 통계 병합, 대시보드 요약의 캐시 hit/miss를 각각 검증하는 pytest 테스트를 구성했습니다.'],
		note: '통계 엔진과 캐시 고도화는 별도 개발 브랜치에서 진행한 작업입니다. main의 서비스 기능과는 적용 범위를 구분해 소개합니다.',
	},
];
---

<PortfolioProjectDetail
	title="Collect Dashboard API"
	eyebrow="Backend Engineering · Data Systems"
	subtitle="통계 집계와 최신성까지 책임지는 FastAPI 백엔드"
	description="도메인별 통계를 일관된 대시보드 API로 통합하고, TTL 캐시와 누적 추세 데이터의 정합성을 다룬 백엔드 프로젝트입니다."
	stack={['Python', 'FastAPI', 'SQLAlchemy', 'pandas', 'APScheduler', 'Docker', 'pytest']}
	sections={sections}
/>
