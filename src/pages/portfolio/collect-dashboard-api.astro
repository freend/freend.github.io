---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const stack = ['Python', 'FastAPI', 'SQLAlchemy', 'pandas', 'APScheduler', 'Docker', 'pytest'];

const stackBadges = [
	{
		name: 'Python',
		url: 'https://img.shields.io/badge/python-3670A0?style=for-the-badge&logo=python&logoColor=ffdd54',
	},
	{
		name: 'FastAPI',
		url: 'https://img.shields.io/badge/FastAPI-009688?style=for-the-badge&logo=fastapi&logoColor=white',
	},
	{
		name: 'SQLAlchemy',
		url: 'https://img.shields.io/badge/SQLAlchemy-D71F00?style=for-the-badge&logo=sqlalchemy&logoColor=white',
	},
	{
		name: 'pandas',
		url: 'https://img.shields.io/badge/pandas-150458?style=for-the-badge&logo=pandas&logoColor=white',
	},
	{
		name: 'APScheduler',
		url: 'https://img.shields.io/badge/APScheduler-2C3E50?style=for-the-badge&logo=python&logoColor=white',
	},
	{
		name: 'Docker',
		url: 'https://img.shields.io/badge/Docker-2496ED?style=for-the-badge&logo=docker&logoColor=white',
	},
	{
		name: 'pytest',
		url: 'https://img.shields.io/badge/pytest-0A9EDC?style=for-the-badge&logo=pytest&logoColor=white',
	},
];

const sections = [
	{
		eyebrow: '01 · 프로젝트 배경',
		title: '분산된 데이터 수집 현황을 한곳에서 관리하기 위해',
		paragraphs: [
			'여러 데이터 수집 시스템이 각각 데이터를 모으고 있었지만, 전체 수집 결과와 현황을 통합해서 집계·관리할 환경은 없었습니다. 도메인마다 저장소를 따로 확인해야 해서 수집 현황과 누적 추세를 한눈에 파악하기 어려웠습니다.',
			'각 저장소의 데이터를 한곳으로 옮기는 대신, 원천별 통계를 조회해 하나의 API로 묶고 대시보드에서 확인할 수 있도록 백엔드를 개발했습니다.',
		],
		cards: [
			{
				title: 'BEFORE · 개별 확인',
				body: '각 수집 시스템 → 개별 데이터 저장소 → 분산된 도메인별 현황과 추세 확인',
			},
			{
				title: 'AFTER · 통합 조회',
				body: '각 데이터 저장소 조회 → 통계 API에서 집계·통합 → 공통 응답으로 대시보드 제공',
			},
		],
		note: '통합하는 대상은 원천 데이터가 아니라 각 저장소에서 조회한 통계입니다. 데이터 저장 위치는 각 도메인에 유지됩니다.',
	},
	{
		eyebrow: '02 · 시스템 아키텍처',
		title: '서로 다른 데이터 저장소를 하나의 통계 API로 연결했습니다',
		paragraphs: [
			'요청은 FastAPI Router에서 인증과 응답 모델을 거쳐 StatsService와 DashboardService로 이어집니다. StatsService는 통계 요청의 진입점을 제공하고, DashboardService는 기업·특허·논문·공시·재무 등 도메인별 Service를 조율합니다.',
			'각 도메인의 Repository는 AsyncSession과 SQLAlchemy 쿼리로 저장소에서 집계값을 가져옵니다. 조회 책임을 도메인별로 나눈 뒤 대시보드 서비스에서 결과를 조립해, 저장소별 집계 방식과 공통 API 응답 구성을 분리했습니다.',
		],
		flow: ['FastAPI Router', 'StatsService', 'DashboardService', '도메인 Service', 'Repository', 'Async SQLAlchemy', '도메인별 저장소'],
		note: '아키텍처와 세부 구현은 확인한 개발 브랜치 기준으로 소개하며, main 반영 상태와 구분했습니다.',
	},
	{
		eyebrow: '03 · 핵심 구현',
		title: '도메인별 집계를 모아 공통 대시보드 응답으로 제공합니다',
		paragraphs: [
			'여러 저장소의 통계를 한 응답으로 모으기 위해 DashboardService가 각 도메인 Service를 asyncio.gather로 병렬 조회합니다. 서비스는 결과를 요약 응답과 기간별 추세 응답으로 정리하고, 재무 통계는 여러 원천에서 가져온 집계값을 하나로 구성합니다.',
			'이 API를 통해 웹 대시보드는 원천 저장소의 구조를 직접 다루지 않고 수집 현황과 누적 추세를 조회합니다. 도메인별 통계 조회와 프런트엔드 연동은 각각 백엔드와 웹 저장소에서 확인했습니다.',
		],
		flow: ['도메인별 통계 조회', 'asyncio.gather 병렬 조율', '결과 통합', '요약·추세 API 응답', '수집 현황 대시보드'],
	},
	{
		eyebrow: '04 · 데이터 최신성과 캐시',
		title: '과거 집계는 재사용하고 당일 수집 현황은 주기적으로 반영합니다',
		paragraphs: [
			'모든 저장소의 누적 데이터를 매번 다시 집계하지 않도록 일일 전체 갱신에서 도메인별 전체 통계를 캐시에 저장합니다. 시간별 갱신은 today_only 결과만 조회해 기존 누적·전일 값과 병합하므로, 오래된 집계의 재사용과 오늘 수집된 데이터 반영을 나눠 처리합니다.',
			'캐시 만료 시간은 설정으로 관리하고, 대시보드 요약 스냅샷은 4,000초 TTL을 사용합니다. 운영 경로에는 TTL 만료를 적용한 MemoryCacheAdapter를 사용하며, 테스트에서는 NoOpCacheAdapter로 캐시 영향을 분리합니다.',
		],
		flow: ['일일 전체 집계', '누적 통계 캐시', '시간별 today_only 조회', '당일 결과 병합', '대시보드 응답'],
	},
	{
		eyebrow: '05 · 테스트와 검증',
		title: '통계 응답과 캐시 동작을 테스트로 확인합니다',
		paragraphs: [
			'pytest 단위 테스트는 메모리 캐시 TTL 만료, 기간 범위 포맷, 대시보드 요약의 cache hit/miss를 다룹니다. HTTPX AsyncClient를 사용하는 통합 테스트는 통계 API의 응답 상태와 필드를 확인합니다.',
			'개발 브랜치에서 선택 테스트를 실행한 결과 8개가 통과하고 2개가 실패했습니다. 실패 두 건은 반환 데이터 구조와 audit 캐시 상태에 대한 테스트 기대가 현재 구현과 어긋난 항목입니다.',
		],
	},
];
---

<PortfolioProjectDetail
	title="Collect Dashboard API"
	eyebrow="Backend Engineering · Data Systems"
	subtitle="분산된 수집 현황을 통합 조회하는 통계 백엔드"
	description="여러 데이터 수집 시스템과 저장소의 현황을 통합해, 도메인별 수집 결과와 누적 추세를 대시보드에서 확인할 수 있도록 개발한 통계 API입니다."
	stack={stack}
	stackBadges={stackBadges}
	sections={sections}
	relatedLinks={[{ label: 'Ent-360 수집 통계 대시보드', href: '/portfolio/ent-360-insight-dashboard' }]}
/>
