---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const stack = ['Java', 'Spring Boot', 'Node.js', 'Express', 'EJS', 'Spring Data JPA', 'PayPal', 'DT One'];
const stackBadges = [
	{ name: 'Java', url: 'https://img.shields.io/badge/Java-ED8B00?style=for-the-badge&logo=openjdk&logoColor=white' },
	{ name: 'Spring Boot', url: 'https://img.shields.io/badge/Spring_Boot-6DB33F?style=for-the-badge&logo=springboot&logoColor=white' },
	{ name: 'Node.js', url: 'https://img.shields.io/badge/Node.js-339933?style=for-the-badge&logo=nodedotjs&logoColor=white' },
	{ name: 'Express', url: 'https://img.shields.io/badge/Express-000000?style=for-the-badge&logo=express&logoColor=white' },
	{ name: 'EJS', url: 'https://img.shields.io/badge/EJS-B4CA65?style=for-the-badge&logo=ejs&logoColor=black' },
	{ name: 'Spring Data JPA', url: 'https://img.shields.io/badge/Spring_Data_JPA-6DB33F?style=for-the-badge&logo=spring&logoColor=white' },
	{ name: 'PayPal', url: 'https://img.shields.io/badge/PayPal-003087?style=for-the-badge&logo=paypal&logoColor=white' },
	{ name: 'DT One', url: 'https://img.shields.io/badge/DT_One-444444?style=for-the-badge' },
];

const sections = [
	{
		eyebrow: '01 · 사업 배경',
		title: '해외 선불 통신 요금제 판매 아이디어를 웹서비스로',
		paragraphs: [
			'친구와 함께 해외에서 사용하는 선불 통신 요금제를 판매하는 사업을 구상했습니다. 고객이 상품을 찾아 회선과 수신자를 선택하고, 결제 뒤 구매 결과를 확인하려면 화면부터 결제 확인, 외부 상품 공급까지 이어지는 서비스 흐름이 필요했습니다.',
			'Whoola는 이 구매 흐름을 갖춘 웹서비스를 구현한 프로젝트입니다. 사업 아이디어를 고객이 이용할 수 있는 기능 흐름으로 구체화한 개발 경험을 보여줍니다.',
		],
		flow: ['요금제 탐색', '수신자·상품 선택', '결제 확인', '통신 상품 공급', '구매 결과 확인'],
	},
	{
		eyebrow: '02 · 시스템 구성',
		title: 'Express 화면 서버와 Spring API가 구매 흐름을 나눠 맡음',
		paragraphs: [
			'Express Renderer는 브라우저 요청을 받아 API에서 필요한 데이터를 가져온 뒤 EJS로 페이지를 렌더링합니다. Spring Boot API는 회원 인증, 상품·수신자 조회, 결제 검증, 구매 기록과 상태를 관리하고 JPA로 저장합니다.',
			'API는 PayPal에 거래 확인을 요청하고, 검증된 통신 상품 구매를 DT One API에 전달합니다. 두 외부 연동은 API 서버에서 처리해 화면 렌더링 코드와 결제·주문 규칙을 분리했습니다.',
		],
		flow: ['Browser', 'Express · EJS Renderer', 'Spring Boot API · JPA', 'MySQL'],
		cards: [
			{ title: '화면 계층', body: '상품 탐색, 수신자 선택, 결제 후 내역을 서버 렌더링 페이지로 제공합니다.' },
			{ title: '서비스 계층', body: '회원·상품·구매 규칙과 결제 검증, 외부 공급사 요청을 API에서 처리합니다.' },
		],
	},
	{
		eyebrow: '03 · 구매 요청의 흐름',
		title: '결제 확인과 통신 상품 공급 결과를 별도로 추적',
		paragraphs: [
			'구매 화면은 상품 가격, 수신자, 선택한 포인트로 결제를 준비합니다. PayPal에서 돌아온 거래 정보는 Spring API가 통화·중복 거래 ID·PayPal 검증 응답·상품 금액·포인트 잔액 순으로 확인한 뒤 구매 처리로 넘깁니다.',
			'PurchaseService는 구매 기록을 남기고 DT One에 상품과 수신 정보를 전송합니다. 정상 응답의 공급사 상태를 구매 기록에 반영하며, 공급 실패와 해석할 수 없는 응답은 각각 ERROR와 PENDING으로 구분해 운영 확인 경로를 남깁니다.',
		],
		flow: ['PayPal 거래 반환', '서버 결제·가격 검증', '구매 기록', 'DT One 요청', '완료·오류·보류 상태'],
		note: 'PayPal 거래 검증과 DT One 상품 요청을 별도 단계로 처리하고, 구매 상태로 공급 결과를 구분합니다.',
	},
	{
		eyebrow: '04 · 구현과 테스트',
		title: '결제 검증과 구매 처리를 서비스 단위로 나눠 구현',
		paragraphs: [
			'Whoola API의 테스트는 Mockito로 저장소와 외부 호출을 대체해 거래 중복, 통화, 가격·포인트 조건과 구매 성공 응답을 확인합니다. Renderer는 라우트에서 입력을 확인하고, API 응답에 따라 EJS 화면 또는 오류 안내를 선택합니다.',
			'Whoola를 대표 프로젝트로 보고 API와 Renderer의 상세 페이지에서 각 서버의 구현과 기술 선택을 따로 살펴볼 수 있습니다.',
		],
	},
];
---

<PortfolioProjectDetail
	title="Whoola"
	eyebrow="E-commerce · Full-stack Web Service"
	subtitle="해외 선불 통신 요금제 판매 사업을 구매 흐름을 갖춘 서비스로"
	description="친구와 구상한 사업 아이디어를 상품 조회, 결제 검증, 외부 상품 주문과 결과 확인으로 이어지는 웹서비스로 구현했습니다."
	stack={stack}
	stackBadges={stackBadges}
	sections={sections}
	relatedLinks={[
		{ label: 'Whoola API · 결제와 구매 처리', href: '/portfolio/whoola-api' },
		{ label: 'Whoola Renderer · 화면 렌더링', href: '/portfolio/whoola-renderer' },
	]}
/>
