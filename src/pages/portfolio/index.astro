		blogLink: null,
	},
];

const focusOptions = [
	{ value: 'all', label: '전체' },
	{ value: 'platform', label: 'DevOps · Platform' },
	{ value: 'backend', label: 'Backend · Full-stack' },
	{ value: 'data', label: 'Data Engineering' },
	{ value: 'ai', label: 'AI · Infrastructure' },
] as const;

const projectPriorities = {
	all: projects.map(({ id }) => id),
	platform: [
		'cloudatlas',
		'aws-infrastructure-as-code',
		'kubernetes-platform-engineering',
		'kubernetes-autoscaling',
		'kubernetes-observability',
		'server-configuration-automation',
		'cross-database-data-synchronization',
		'dart-data-collection',
		'local-ai-extraction',
		'collect-dashboard',
		'whoola',
	],
	backend: [
