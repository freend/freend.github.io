		'whoola',
	],
};
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`Portfolio | ${SITE_TITLE}`} description="클라우드와 소프트웨어 엔지니어링 프로젝트를 소개합니다." />
		<style>
			.page-intro { margin: 2.5rem 0; }
			.page-intro h1 { margin-top: 0; }
			.page-intro p { max-width: 620px; color: #656d76; line-height: 1.75; }
			.portfolio-controls { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.85rem 1.25rem; margin: 1.5rem 0; }
			.focus-options { display: flex; flex-wrap: wrap; gap: 0.5rem; max-width: 100%; }
			.focus-button { max-width: 100%; padding: 0.5rem 0.8rem; border: 1px solid var(--border); border-radius: 999px; background: var(--bg); color: var(--text); font: inherit; font-size: 0.9rem; line-height: 1.35; cursor: pointer; }
			.focus-button:hover { border-color: var(--link); }
			.focus-button[aria-pressed="true"] { border-color: var(--link); background: var(--code-bg); color: var(--link); font-weight: 600; }
			.focus-button:focus-visible, .copy-link-button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
			.share-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; }
			.copy-link-button { padding: 0; border: 0; background: transparent; color: var(--link); font: inherit; font-size: 0.9rem; text-decoration: underline; cursor: pointer; }
			.copy-feedback { min-height: 1.3em; color: #656d76; font-size: 0.82rem; }
			.project-list { display: grid; gap: 1rem; margin: 2rem 0; }
			.project-card { min-width: 0; padding: 1.25rem; border: 1px solid var(--border); border-radius: 8px; }
			.project-group-heading { margin: 2rem 0 0; border: 0; padding: 1.4rem 0 0.2rem; border-top: 1px solid var(--border); font-size: 1.25rem; }
			.project-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.2rem 1rem; }
			.project-card h2 { margin: 0; border: 0; padding: 0; font-size: 1.45rem; }
			.project-tagline { margin: 0.25rem 0 0; color: #656d76; font-weight: 600; }
			.participation { margin: 0; color: #656d76; font-size: 0.85rem; white-space: nowrap; }
			.project-description { max-width: 760px; margin: 0.9rem 0; line-height: 1.7; }
			.project-card h3 { margin: 1rem 0 0.35rem; font-size: 0.95rem; }
			.feature-list { display: flex; flex-wrap: wrap; gap: 0.15rem 1.5rem; margin: 0; padding-left: 1.15rem; }
			.feature-list li { margin: 0.15rem 0; }
			.stack-badges { display: flex; flex-wrap: wrap; gap: 0.45rem; max-width: 100%; margin: 0; padding: 0; list-style: none; }
			.stack-badges li { max-width: 100%; margin: 0; }
			.stack-badges img { display: block; max-width: 100%; height: 24px; border: 0; filter: none; }
			.project-links { display: grid; gap: 0.25rem; margin-top: 0.3rem; }
			.project-detail-link { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.1rem 0.65rem; width: fit-content; max-width: 100%; padding: 0.2rem 0; }
			.project-detail-link strong { font-size: 0.92rem; }
			.project-detail-link span { color: #656d76; font-size: 0.85rem; }
			.project-blog-link { margin: 0.35rem 0 0; font-size: 0.86rem; overflow-wrap: anywhere; }
			.project-blog-link span { margin-right: 0.4rem; color: #656d76; }
			@media (max-width: 600px) {
				.project-card { padding: 1rem; }
				.project-heading { align-items: flex-start; }
				.project-tagline { font-size: 0.92rem; }
				.feature-list { display: block; }
				.stack-badges { gap: 0.4rem; }
				.stack-badges img { height: 22px; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-intro">
				<p class="eyebrow">SELECTED WORK</p>
				<h1>Portfolio</h1>
				<p>서비스 개발, 데이터 엔지니어링, 클라우드·플랫폼, GPU 추론 인프라까지 문제의 전체 흐름을 설계하고 구현한 프로젝트를 소개합니다.</p>
			</header>
			<div
				class="portfolio-controls"
				data-portfolio-controls
				data-priorities={JSON.stringify(projectPriorities)}
			>
				<div class="focus-options" role="group" aria-label="관심 직무별 프로젝트 우선순위">
					{focusOptions.map((option) => (
						<button
							type="button"
							class="focus-button"
							data-focus={option.value}
							aria-pressed={option.value === 'all' ? 'true' : 'false'}
						>
							{option.label}
						</button>
					))}
				</div>
				<div class="share-controls">
					<button class="copy-link-button" type="button" data-copy-link>링크 복사</button>
					<span class="copy-feedback" data-copy-feedback role="status" aria-live="polite"></span>
				</div>
			</div>
			<section class="project-list" aria-label="프로젝트 목록">
				{projects.map((project, index) => (
					<>
					{index === 4 && <h2 class="project-group-heading" data-project-group-heading>Infrastructure &amp; Data Engineering</h2>}
					<article class="project-card" data-project-id={project.id}>
						<div class="project-heading">
							<div>
								<h2>{project.name}</h2>
								<p class="project-tagline">{project.tagline}</p>
							</div>
							<p class="participation">{project.participation}</p>
						</div>
						<p class="project-description">{project.description}</p>
						<h3>핵심 구현</h3>
						<ul class="feature-list">{project.features.map((feature) => <li>{feature}</li>)}</ul>
						<h3>주요 기술</h3>
						<ul class="stack-badges" aria-label={`${project.name} 주요 기술`}>
							{project.badges.map((item) => <li><img src={item.url} alt={item.name} loading="lazy" /></li>)}
						</ul>
						<h3>{project.links.length > 1 ? '프로젝트 구성' : '상세 페이지'}</h3>
						<nav class="project-links" aria-label={`${project.name} 상세 페이지`}>
							{project.links.map((link) => (
								<a class="project-detail-link" href={link.href}>
									<strong>{link.label}</strong><span>{link.description}</span>
								</a>
							))}
						</nav>
						{project.blogLink && <p class="project-blog-link"><span>관련 기술 기록</span><a href={project.blogLink.href}>{project.blogLink.title} <span aria-hidden="true">↗</span></a></p>}
					</article>
					</>
				))}
			</section>
		</main>
		<Footer />
<script>
	const controls = document.querySelector('[data-portfolio-controls]');
	const projectList = document.querySelector('.project-list');

	if (controls && projectList) {
		const priorities = JSON.parse(controls.dataset.priorities || '{}');
		const buttons = Array.from(controls.querySelectorAll('[data-focus]'));
		const focusValues = new Set(buttons.map((button) => button.dataset.focus));
		const cards = Array.from(projectList.querySelectorAll('[data-project-id]'));
		const cardsById = new Map(cards.map((card) => [card.dataset.projectId, card]));
		const groupHeading = projectList.querySelector('[data-project-group-heading]');
		const copyButton = controls.querySelector('[data-copy-link]');
		const copyFeedback = controls.querySelector('[data-copy-feedback]');

		const currentFocusFromUrl = () => {
			const url = new URL(window.location.href);
			const requested = url.searchParams.get('focus');
			if (requested === null) return 'all';
			if (focusValues.has(requested)) return requested;

			url.searchParams.delete('focus');
			history.replaceState(history.state, '', `${url.pathname}${url.search}${url.hash}`);
			return 'all';
		};

		const applyFocus = (focus) => {
			const normalizedFocus = focusValues.has(focus) ? focus : 'all';
			const orderedIds = priorities[normalizedFocus] || priorities.all || [];
			const orderedCards = orderedIds.map((id) => cardsById.get(id)).filter(Boolean);
			const includedCards = new Set(orderedCards);

			cards.forEach((card) => {
				if (!includedCards.has(card)) orderedCards.push(card);
			});

			if (groupHeading) groupHeading.remove();
			orderedCards.forEach((card) => projectList.append(card));
			if (normalizedFocus === 'all' && groupHeading && orderedCards[4]) {
				projectList.insertBefore(groupHeading, orderedCards[4]);
			}

			buttons.forEach((button) => {
				button.setAttribute('aria-pressed', String(button.dataset.focus === normalizedFocus));
			});
		};

		const selectFocus = (focus, addHistoryEntry) => {
			const normalizedFocus = focusValues.has(focus) ? focus : 'all';
			if (addHistoryEntry) {
				const url = new URL(window.location.href);
				if (normalizedFocus === 'all') url.searchParams.delete('focus');
				else url.searchParams.set('focus', normalizedFocus);
				const nextUrl = `${url.pathname}${url.search}${url.hash}`;
				const currentUrl = `${window.location.pathname}${window.location.search}${window.location.hash}`;
				if (nextUrl !== currentUrl) history.pushState({ focus: normalizedFocus }, '', nextUrl);
			}
			applyFocus(normalizedFocus);
		};

		buttons.forEach((button) => {
			button.addEventListener('click', () => selectFocus(button.dataset.focus, true));
		});

		window.addEventListener('popstate', () => selectFocus(currentFocusFromUrl(), false));
		selectFocus(currentFocusFromUrl(), false);

		if (copyButton && copyFeedback) {
			copyButton.addEventListener('click', async () => {
				let copied = false;
				try {
					if (navigator.clipboard?.writeText) {
						await navigator.clipboard.writeText(window.location.href);
						copied = true;
					}
				} catch {
					copied = false;
				}

				if (!copied) {
					const field = document.createElement('textarea');
					field.value = window.location.href;
					field.setAttribute('readonly', '');
					field.style.position = 'fixed';
					field.style.opacity = '0';
					document.body.append(field);
					field.select();
					try {
						copied = document.execCommand('copy');
					} catch {
						copied = false;
					} finally {
						field.remove();
					}
				}

				copyFeedback.textContent = copied
					? '링크를 복사했어요.'
					: '복사하지 못했어요. 주소창에서 링크를 복사해 주세요.';
			});
		}
	}
</script>
	</body>
</html>
