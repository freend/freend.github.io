---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const projects = [
	{
		slug: 'cloudatlas',
		name: 'CloudAtlas',
		tagline: 'Cloud Infrastructure Relationship Explorer',
		description: '클라우드 리소스와 연결 관계를 그래프로 시각화해 복잡한 인프라 구조를 탐색하는 개인 프로젝트입니다.',
		stack: ['Python', 'AWS', 'React', 'TypeScript', 'Graph Visualization', 'AI Agent'],
		features: ['AWS 리소스 정보 수집', '리소스 관계 모델링과 그래프 시각화', '리소스 검색·선택과 연결된 리소스 탐색', '리소스 상세 정보 확인'],
	},
	{
		slug: 'ent-360-insight-dashboard',
		name: 'Ent-360 Insight Dashboard',
		tagline: '기업 데이터 통합 조회 및 분석 대시보드',
		description: '기업 정보, 공시·감사보고서와 관련 통계를 한곳에서 조회하고 살펴보는 풀스택 대시보드입니다.',
		stack: ['Next.js', 'React', 'TypeScript', 'Tailwind CSS', 'Python', 'FastAPI', 'Docker'],
		features: ['기업·재무·고용 정보 통합 조회', '공시 및 감사보고서 데이터 탐색', '특허·벤처 데이터와 통계 대시보드', '프런트엔드 서비스 계층과 API 연동'],
	},
	{
		slug: 'collect-dashboard-api',
		name: 'Collect Dashboard API',
		tagline: '통계 조회와 집계를 위한 백엔드 API',
		description: '대시보드에서 사용하는 기업 통계와 추세 데이터를 조회·집계하는 백엔드 API 개발 경험을 정리합니다.',
		stack: ['Python', 'FastAPI', 'SQLAlchemy', 'pandas', 'APScheduler', 'Docker', 'pytest'],
		features: ['대시보드 요약 및 추세 조회 API', '기업·재무·고용 통계 집계', 'TTL 기반 캐시 인터페이스와 당일 통계 병합', '캐시·요약·추세 테스트 구성'],
	},
	{
		slug: 'linux-qwen-extraction',
		name: 'Linux Qwen Extraction',
		tagline: 'Linux와 NVIDIA GPU 기반 LLM 추론 환경',
		description: 'Linux GPU 환경에서 llama.cpp와 GGUF 형식의 Qwen 모델을 실행하기 위한 컨테이너 기반 추론 인프라 실험입니다.',
		stack: ['Linux', 'NVIDIA GPU', 'CUDA', 'llama.cpp', 'GGUF', 'Qwen', 'Docker', 'Python'],
		features: ['CUDA 기반 llama.cpp 빌드 및 런타임 구성', 'GGUF 모델을 사용하는 추론 서버', 'Python HTTP 어댑터와 모델 해시 확인', '벤치마크·리소스 모니터링 도구'],
	},
	{
		slug: 'whoola-renderer',
		name: 'Whoola Renderer',
		tagline: 'EJS 기반 서버 사이드 렌더링 서버',
		description: 'Express와 EJS로 페이지를 렌더링하고 별도 API 서버와 연결하는 웹 렌더링 프로젝트입니다.',
		stack: ['Node.js', 'Express', 'EJS', 'i18n', 'Bootstrap 4', 'Docker'],
		features: ['EJS 템플릿 기반 서버 렌더링', '라우트와 뷰 템플릿 분리', '영어·한국어 로케일 설정', '미들웨어와 정적 자산 제공'],
	},
	{
		slug: 'whoola-api',
		name: 'Whoola API',
		tagline: 'Spring Boot 기반 도메인 API 서버',
		description: '도메인별 컨트롤러·서비스·저장소를 구성하고 Renderer와 분리한 Java 백엔드 API입니다.',
		stack: ['Java', 'Spring Boot', 'Spring Web', 'Spring Data JPA', 'Spring Security', 'JWT', 'Gradle'],
		features: ['도메인 단위 API 모듈 구성', '회원 인증 및 정보 API', 'JPA 기반 엔티티와 저장소', 'Renderer가 HTTP로 호출하는 API 역할 분리'],
	},
];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`Portfolio | ${SITE_TITLE}`} description="클라우드와 소프트웨어 엔지니어링 프로젝트를 소개합니다." />
		<style>
			.page-intro { margin: 2.5rem 0; }
			.page-intro h1 { margin-top: 0; }
			.page-intro p { max-width: 620px; color: #656d76; line-height: 1.75; }
			.project-list { display: grid; gap: 1rem; margin: 2rem 0; }
			.project-card { padding: 1.4rem; border: 1px solid var(--border); border-radius: 8px; }
			.project-card h2 { margin-top: 0; border: 0; padding: 0; }
			.project-card h2 a { text-decoration: none; }
			.project-tagline { margin: -0.6rem 0 1rem; color: #656d76; font-weight: 600; }
			.project-description { max-width: 680px; line-height: 1.75; }
			.project-card h3 { margin: 1.2rem 0 0.4rem; font-size: 1rem; }
			.project-card ul { margin-top: 0.4rem; }
			.tag-list { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; list-style: none; }
			.tag-list li { margin: 0; padding: 0.2rem 0.55rem; border: 1px solid var(--border); border-radius: 999px; color: #656d76; font-size: 0.82rem; }
			.project-link { display: inline-flex; margin-top: 1.1rem; font-weight: 600; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-intro">
				<p class="eyebrow">SELECTED WORK</p>
				<h1>Portfolio</h1>
				<p>운영 현장에서 발견한 문제를 시스템과 도구로 풀어낸 프로젝트를 소개합니다. 프로젝트 항목은 이 목록에 추가할 수 있습니다.</p>
			</header>
			<section class="project-list" aria-label="프로젝트 목록">
				{projects.map((project) => (
					<article class="project-card">
						<h2><a href={`/portfolio/${project.slug}`}>{project.name}</a></h2>
						<p class="project-tagline">{project.tagline}</p>
						<p class="project-description">{project.description}</p>
						<h3>주요 기능</h3>
						<ul>{project.features.map((feature) => <li>{feature}</li>)}</ul>
						<h3>주요 기술</h3>
						<ul class="tag-list" aria-label={`${project.name} 주요 기술`}>{project.stack.map((item) => <li>{item}</li>)}</ul>
						<a class="project-link" href={`/portfolio/${project.slug}`}>프로젝트 상세 보기 <span aria-hidden="true"> →</span></a>
					</article>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>
