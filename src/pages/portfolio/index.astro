---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const projects = [
	{
		slug: 'cloudatlas',
		name: 'CloudAtlas',
		tagline: 'Cloud Infrastructure Relationship Explorer',
		description: '클라우드 리소스와 연결 관계를 그래프로 시각화해 복잡한 인프라 구조를 탐색하는 개인 프로젝트입니다.',
		stack: ['Python', 'AWS', 'React', 'TypeScript', 'Graph Visualization', 'AI Agent'],
		features: ['AWS 리소스 정보 수집', '리소스 관계 모델링과 그래프 시각화', '리소스 검색·선택과 연결된 리소스 탐색', '리소스 상세 정보 확인'],
	},
	{
		slug: 'ent-360-insight-dashboard',
		name: 'Collect Dashboard',
		tagline: 'Data Platform · Full-stack',
		description: '분산된 데이터 수집 현황을 통계 API로 통합하고, Ent-360 대시보드에서 도메인별 결과와 추세를 확인할 수 있도록 만든 데이터 플랫폼입니다.',
		stack: ['Python', 'FastAPI', 'SQLAlchemy', 'Next.js', 'React', 'TypeScript', 'Docker'],
		features: ['원천 저장소별 수집 통계 조회와 통합 응답', '기업·특허·공시·벤처 수집 현황 시각화', '요약 지표와 상세 통계 화면 연동', '런타임 API 연결을 지원하는 웹 실행 구성'],
		related: [
			{ slug: 'collect-dashboard-api', label: 'Collect Dashboard API 상세' },
		],
	},
	{
		slug: 'linux-qwen-extraction',
		name: 'Linux Qwen Extraction',
		tagline: 'Local AI · GPU Inference',
		description: '이미지와 영상의 시각정보를 로컬 Qwen 모델로 추론하고 애플리케이션에서 다룰 구조화 데이터로 변환하는 Linux GPU 시스템입니다.',
		stack: ['Linux', 'NVIDIA GPU', 'CUDA', 'llama.cpp', 'GGUF', 'Qwen', 'Docker', 'Python'],
		features: ['FastAPI 이미지·영상 추출 엔드포인트', 'FFmpeg로 영상 프레임 검증·샘플링', 'llama.cpp 서버와 Qwen GGUF 추론 연결', '모델 체크섬 및 JSON 완결성 검사'],
	},
	{
		slug: 'whoola',
		name: 'Whoola',
		tagline: 'Prepaid Telecom · Full-stack',
		description: '친구와 함께 구상한 해외 선불 통신 요금제 판매 사업을 상품 조회, 결제 확인, 주문 처리까지 갖춘 웹서비스로 구현했습니다.',
		stack: ['Java', 'Spring Boot', 'Node.js', 'Express', 'EJS', 'Spring Data JPA', 'PayPal', 'DT One'],
		features: ['요금제와 수신자 선택부터 구매 결과까지의 흐름', 'PayPal 거래·금액·포인트 검증 API', 'DT One 외부 상품 공급 요청과 상태 처리', 'API와 EJS 서버 렌더링 역할 분리'],
		related: [
			{ slug: 'whoola-api', label: 'Whoola API 상세' },
			{ slug: 'whoola-renderer', label: 'Whoola Renderer 상세' },
		],
	},
];
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`Portfolio | ${SITE_TITLE}`} description="클라우드와 소프트웨어 엔지니어링 프로젝트를 소개합니다." />
		<style>
			.page-intro { margin: 2.5rem 0; }
			.page-intro h1 { margin-top: 0; }
			.page-intro p { max-width: 620px; color: #656d76; line-height: 1.75; }
			.project-list { display: grid; gap: 1rem; margin: 2rem 0; }
			.project-card { padding: 1.4rem; border: 1px solid var(--border); border-radius: 8px; }
			.project-card h2 { margin-top: 0; border: 0; padding: 0; }
			.project-card h2 a { text-decoration: none; }
			.project-tagline { margin: -0.6rem 0 1rem; color: #656d76; font-weight: 600; }
			.project-description { max-width: 680px; line-height: 1.75; }
			.project-card h3 { margin: 1.2rem 0 0.4rem; font-size: 1rem; }
			.project-card ul { margin-top: 0.4rem; }
			.tag-list { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; list-style: none; }
			.tag-list li { margin: 0; padding: 0.2rem 0.55rem; border: 1px solid var(--border); border-radius: 999px; color: #656d76; font-size: 0.82rem; }
			.project-link { display: inline-flex; margin-top: 1.1rem; font-weight: 600; }
			.project-related { display: flex; flex-wrap: wrap; gap: 0.55rem 1rem; margin: 0.85rem 0 0; font-size: 0.9rem; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-intro">
				<p class="eyebrow">SELECTED WORK</p>
				<h1>Portfolio</h1>
				<p>서비스 개발부터 백엔드, 클라우드, GPU 추론 인프라까지 문제의 전체 흐름을 설계하고 구현한 프로젝트를 소개합니다.</p>
			</header>
			<section class="project-list" aria-label="프로젝트 목록">
				{projects.map((project) => (
					<article class="project-card">
						<h2><a href={`/portfolio/${project.slug}`}>{project.name}</a></h2>
						<p class="project-tagline">{project.tagline}</p>
						<p class="project-description">{project.description}</p>
						<h3>주요 기능</h3>
						<ul>{project.features.map((feature) => <li>{feature}</li>)}</ul>
						<h3>주요 기술</h3>
						<ul class="tag-list" aria-label={`${project.name} 주요 기술`}>{project.stack.map((item) => <li>{item}</li>)}</ul>
						<a class="project-link" href={`/portfolio/${project.slug}`}>{project.related ? '대표 프로젝트 보기' : '프로젝트 상세 보기'} <span aria-hidden="true"> →</span></a>
						{project.related && <nav class="project-related" aria-label={`${project.name} 관련 상세 페이지`}>{project.related.map((item) => <a href={`/portfolio/${item.slug}`}>{item.label} <span aria-hidden="true">↗</span></a>)}</nav>}
					</article>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>
