---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const sections = [
	{
		eyebrow: 'Rendering Server',
		title: 'Express 요청을 EJS 화면으로 완성',
		paragraphs: ['Whoola Renderer는 브라우저 요청을 받아 필요한 데이터를 별도 API에서 가져오고 EJS 템플릿을 HTML로 렌더링합니다. 저는 라우트와 뷰를 연결하는 서버 구조를 구현하고, API의 도메인 처리는 백엔드 서버에 맡겼습니다.'],
		flow: ['Browser request', 'Express route', 'Whoola API', 'EJS HTML response'],
	},
	{
		eyebrow: '다국어 화면',
		title: '공통 템플릿에 영어·한국어 로케일 연결',
		paragraphs: ['i18n 미들웨어와 영어(en)·한국어(ko) 번역 파일을 추가해 템플릿에서 언어별 문구를 키로 불러오도록 구성했습니다. 언어 전환은 라우트에서 처리하고, 화면 문자열은 locale 리소스로 분리했습니다.'],
		cards: [
			{ title: '요청 단위 locale', body: 'Express 요청에 i18n 초기화를 적용해 뷰에서 현재 언어와 번역 함수를 사용할 수 있게 했습니다.' },
			{ title: 'EJS 템플릿', body: '페이지 렌더링에 필요한 데이터를 라우트에서 준비하고, EJS view에서 응답 화면을 조립합니다.' },
		],
	},
	{
		eyebrow: '책임 분리',
		title: 'HTML 렌더링과 서비스 규칙을 나누다',
		paragraphs: ['Renderer는 요청 라우팅, API 호출, 템플릿 렌더링을 맡고 Whoola API는 회원·상품·구매 데이터 처리를 담당합니다. 이 경계 덕분에 화면 응답 형식과 백엔드 도메인 로직을 각 서버의 역할 안에서 다룰 수 있습니다.'],
	},
];
---

<PortfolioProjectDetail
	title="Whoola Renderer"
	eyebrow="Server-Side Rendering · Web"
	subtitle="Express와 EJS로 페이지를 서버에서 렌더링하는 웹 서버"
	description="저는 EJS 화면 렌더링, API 연동, 영어·한국어 전환을 담당하는 Node.js 서버를 구현했습니다."
	stack={['Node.js', 'Express', 'EJS', 'i18n', 'Bootstrap 4', 'Docker']}
	sections={sections}
/>
