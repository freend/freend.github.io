---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const sections = [
	{
		eyebrow: '개요와 해결하려던 문제',
		title: '템플릿을 서버에서 렌더링하는 웹 서버',
		paragraphs: [
			'Whoola Renderer는 Express와 EJS를 이용해 요청에 맞는 HTML 페이지를 서버에서 생성하는 애플리케이션입니다. 화면 렌더링과 API 서버의 역할을 분리해 웹 페이지 제공과 서비스 데이터 처리를 나눕니다.',
			'저장소 README에는 상세한 문제 정의가 없어, 이 페이지에서는 코드와 의존성에서 확인되는 렌더러 구조를 중심으로 설명합니다.',
		],
	},
	{
		eyebrow: '주요 기능',
		title: '라우트와 뷰, 로케일 처리',
		bullets: [
			'Express 라우트에서 요청을 처리하고 EJS 템플릿을 렌더링합니다.',
			'뷰 파일을 페이지 단위로 구성하고 EJS locals 기능을 사용합니다.',
			'i18n 설정에 영어와 한국어 로케일 및 번역 파일이 있습니다.',
			'정적 자산 제공, 요청 파싱, 압축 등 Express 미들웨어를 사용합니다.',
		],
	},
	{
		eyebrow: '아키텍처와 핵심 구현',
		title: 'HTTP 요청 렌더링과 API 호출의 경계',
		cards: [
			{ title: '서버 렌더링', body: 'Express 앱에서 EJS를 뷰 엔진으로 설정하고 라우트가 템플릿을 선택해 서버 응답 HTML을 구성합니다.' },
			{ title: '다국어', body: 'i18n 미들웨어와 로케일 리소스 파일을 연결하고 영어·한국어 경로 전환 처리를 둡니다.' },
			{ title: 'API 역할 분리', body: '일부 라우트는 HTTP 클라이언트를 통해 별도 API 서버를 호출합니다. Renderer가 데이터 저장 API 자체를 대신하지 않도록 책임을 분리한 구조입니다.' },
		],
	},
	{
		eyebrow: '기술적 의사결정과 검증',
		title: '확인 가능한 구현 범위만 소개',
		paragraphs: ['Node.js 패키지 의존성과 Docker 설정에서 Express, EJS, i18n, Bootstrap 4, 컨테이너 실행 구성을 확인했습니다. 저장소에서 별도의 테스트 스크립트나 테스트 디렉터리를 확인하지 못해 자동 검증 결과를 주장하지 않습니다.'],
		note: '저장소의 문서가 간략하여 세부 동작이나 서비스 수준의 검증 결과는 이 소개에서 추정하지 않습니다.',
	},
];
---

<PortfolioProjectDetail
	title="Whoola Renderer"
	eyebrow="서버 사이드 렌더링"
	subtitle="Express와 EJS로 HTML 화면을 구성하는 웹 렌더링 서버"
	description="EJS 템플릿 처리, 다국어 라우팅, 별도 API 호출을 담당하는 서버 사이드 렌더링 프로젝트입니다."
	stack={['Node.js', 'Express', 'EJS', 'i18n', 'Bootstrap 4', 'Docker']}
	sections={sections}
/>
