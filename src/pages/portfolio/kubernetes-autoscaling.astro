---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const stack = ['Karpenter', 'Kubernetes', 'Helm', 'AWS', 'Amazon SQS', 'EventBridge'];
const stackBadges = [
	{ name: 'Karpenter', url: 'https://img.shields.io/badge/Karpenter-7B42BC?style=for-the-badge' },
	{ name: 'Kubernetes', url: 'https://img.shields.io/badge/Kubernetes-326CE5?style=for-the-badge&logo=kubernetes&logoColor=white' },
	{ name: 'Helm', url: 'https://img.shields.io/badge/Helm-0F1689?style=for-the-badge&logo=helm&logoColor=white' },
	{ name: 'AWS', url: 'https://img.shields.io/badge/AWS-232F3E?style=for-the-badge&logo=amazonaws&logoColor=white' },
	{ name: 'Amazon SQS', url: 'https://img.shields.io/badge/Amazon_SQS-232F3E?style=for-the-badge&logo=amazonaws&logoColor=white' },
	{ name: 'EventBridge', url: 'https://img.shields.io/badge/EventBridge-232F3E?style=for-the-badge&logo=amazonaws&logoColor=white' },
];

const sections = [
	{
		eyebrow: '01 · WHY',
		title: '워크로드 자원 요구와 클라우드 중단 이벤트를 각각 다뤘습니다',
		paragraphs: [
			'워크로드가 사용할 노드 자원을 관리하는 일과 클라우드 중단 이벤트에 대응할 기반을 마련하는 일은 서로 다른 운영 관심사였습니다. Karpenter의 노드 설정과 AWS 이벤트 관련 리소스를 각각 구성해 Kubernetes와 클라우드 양쪽의 관리 지점을 다뤘습니다.',
		],
	},
	{
		eyebrow: '02 · HOW',
		title: 'Karpenter 노드 설정과 AWS 이벤트 구성을 각 관리 도구에 반영',
		paragraphs: [
			'Karpenter Helm values와 Node 관련 설정으로 노드 관리 정책을 구성하고 interruptionQueue 항목을 관리했습니다. 별도로, 노드 중단 이벤트와 관련된 SQS·EventBridge 리소스는 Terraform으로 관리했습니다.',
		],
		cards: [
			{ title: '워크로드에 맞춘 노드 관리', body: 'Karpenter Helm values와 Node 관련 설정을 관리하고, 적용 후 노드와 배포 상태를 확인했습니다.' },
			{ title: '중단 이벤트 관련 구성', body: 'Terraform으로 SQS·EventBridge 관련 리소스를 관리하고 Karpenter Helm values의 interruptionQueue 항목을 설정했습니다.' },
		],
	},
	{
		eyebrow: '03 · WHAT',
		title: '노드 관리 정책과 중단 이벤트 관련 설정을 마련했습니다',
		flow: ['워크로드 자원 요구', 'Karpenter 노드 관리 설정', 'Kubernetes 노드 수명주기'],
		bullets: [
			'워크로드 자원 요구에 대응하는 Karpenter Helm values 및 Node 설정 관리',
			'Terraform 기반 SQS·EventBridge 관련 리소스와 Karpenter interruptionQueue 설정',
			'Helm·Terraform 변경 적용 이력과 노드·배포 상태 확인',
		],
	},
	{
		eyebrow: '04 · ENGINEERING DECISIONS',
		title: '노드 정책과 AWS 이벤트 리소스를 각 계층에서 관리했습니다',
		paragraphs: [
			'노드 정책과 AWS 이벤트 기반을 별도의 변경 단위로 관리했습니다. Karpenter 노드 설정은 Helm으로 적용하고, SQS·EventBridge 관련 리소스는 Terraform으로 관리해 각 계층에서 설정 이력을 확인할 수 있게 했습니다.',
			'Karpenter의 interruptionQueue 항목은 노드 관리 설정 안에서 함께 다뤘으며, 변경 후에는 노드와 배포 상태를 확인했습니다.',
		],
	},
];
---

<PortfolioProjectDetail
	title="Kubernetes Autoscaling"
	eyebrow="직접 설계·구축·관리 · Node Lifecycle Management"
	subtitle="Karpenter 노드 관리와 AWS 중단 이벤트 구성을 다룬 Kubernetes 운영 사례"
	description="워크로드 자원 요구에 맞춘 Karpenter 설정과 중단 이벤트 관련 AWS 리소스를 Helm·Terraform으로 구성하고 적용 상태를 확인했습니다."
	stack={stack}
	stackBadges={stackBadges}
	sections={sections}
	relatedLinks={[
		{ label: 'Kubernetes Platform Engineering', href: '/portfolio/kubernetes-platform-engineering' },
		{ label: 'Kubernetes Observability', href: '/portfolio/kubernetes-observability' },
	]}
/>
