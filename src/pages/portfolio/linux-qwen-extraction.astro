---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const stack = ['Linux', 'NVIDIA GPU', 'CUDA', 'llama.cpp', 'GGUF', 'Qwen', 'Docker', 'Python', 'FastAPI', 'FFmpeg'];
const stackBadges = [
	{ name: 'Linux', url: 'https://img.shields.io/badge/Linux-FCC624?style=for-the-badge&logo=linux&logoColor=black' },
	{ name: 'NVIDIA GPU', url: 'https://img.shields.io/badge/NVIDIA_GPU-76B900?style=for-the-badge&logo=nvidia&logoColor=white' },
	{ name: 'CUDA', url: 'https://img.shields.io/badge/CUDA-76B900?style=for-the-badge&logo=nvidia&logoColor=white' },
	{ name: 'llama.cpp', url: 'https://img.shields.io/badge/llama.cpp-3B82F6?style=for-the-badge' },
	{ name: 'GGUF', url: 'https://img.shields.io/badge/GGUF-5B5B5B?style=for-the-badge' },
	{ name: 'Qwen', url: 'https://img.shields.io/badge/Qwen-615EFF?style=for-the-badge&logo=alibabacloud&logoColor=white' },
	{ name: 'Docker', url: 'https://img.shields.io/badge/Docker-2496ED?style=for-the-badge&logo=docker&logoColor=white' },
	{ name: 'Python', url: 'https://img.shields.io/badge/Python-3670A0?style=for-the-badge&logo=python&logoColor=ffdd54' },
	{ name: 'FastAPI', url: 'https://img.shields.io/badge/FastAPI-009688?style=for-the-badge&logo=fastapi&logoColor=white' },
	{ name: 'FFmpeg', url: 'https://img.shields.io/badge/FFmpeg-007808?style=for-the-badge&logo=ffmpeg&logoColor=white' },
];

const sections = [
	{
		eyebrow: '01 · 시작한 이유',
		title: '화면의 거래 정보를 직접 입력하는 과정을 줄이기 위해',
		paragraphs: [
			'화면에 표시된 거래 내역 등의 정보를 사람이 직접 확인해 입력하는 과정이 번거로웠습니다. 화면의 시각 정보를 이해하는 비전 언어 모델을 찾아 로컬에서 실행해 보고, 입력 전처리부터 추론과 결과 변환까지 제어할 수 있도록 Linux GPU 기반 처리 흐름을 구성했습니다.',
			'기존 Qwen 계열 VLM을 Linux GPU 추론 환경과 FastAPI 추출 API에 연결해 이미지와 영상의 정보를 구조화된 데이터로 변환했습니다. 기존 모델을 실제 입력 자동화 문제에 적용할 수 있도록 실행 환경과 처리 파이프라인을 구현한 경험입니다.',
		],
	},
	{
		eyebrow: '02 · 추출 파이프라인',
		title: '이미지·영상 입력을 검증하고 추론 결과를 JSON으로 변환',
		paragraphs: [
			'FastAPI가 이미지·영상 입력의 형식과 크기를 확인하고 추론 가능한 데이터로 전처리합니다. 영상은 FFprobe로 스트림과 프레임 시각을 확인한 뒤 FFmpeg로 2 FPS 샘플을 만들며, 프레임 타임라인이 누락되거나 역순이면 추론 전에 입력 오류로 처리합니다.',
			'전처리한 미디어는 OpenAI 호환 API를 제공하는 llama-server에 전달합니다. LlamaClient는 입력 토큰과 컨텍스트 한도를 확인한 후 추론을 요청하고, 응답 파서는 완결된 JSON 결과를 애플리케이션에서 사용할 필드로 변환합니다.',
		],
		flow: ['이미지·영상 업로드', 'FastAPI 입력 검증', 'FFmpeg 영상 샘플링', 'Qwen GGUF 로컬 추론', '응답 파싱과 JSON 결과'],
		bullets: [
			'이미지 형식·업로드 크기·영상 길이를 확인하고 파일 확장자와 실제 인코딩이 일치하는지 검사',
			'영상 샘플 프레임의 시각 정보가 순서와 간격 기준을 만족하는지 검증',
			'컨텍스트 한도 초과, 추론 서버 오류, 불완전한 모델 응답을 구분해 처리',
		],
	},
	{
		eyebrow: '03 · GPU 추론 환경',
		title: 'Linux GPU에서 로컬 모델과 추출 API를 분리해 실행',
		paragraphs: [
			'Docker Compose에서 NVIDIA GPU·CUDA를 사용하는 llama.cpp 추론 서버와 FastAPI를 별도 서비스로 구성했습니다. Qwen GGUF 모델은 추론 서버에서 실행하고, FastAPI는 입력 검증·미디어 전처리·응답 변환을 맡도록 역할을 나눴습니다.',
			'모델 파일은 읽기 전용으로 연결하고 서비스 간 요청은 내부 네트워크에서 전달합니다. API는 동시 추론을 제한하고, 입력 토큰과 모델 컨텍스트 한도를 확인해 추론 요청을 처리합니다.',
		],
		flow: ['FastAPI · 업로드 / 전처리', '내부 HTTP 요청', 'llama.cpp · Qwen GGUF', 'NVIDIA GPU · CUDA'],
	},
	{
		eyebrow: '04 · 검증',
		title: '합성 미디어와 모델 응답으로 처리 경계를 확인',
		paragraphs: [
			'pytest와 FastAPI TestClient로 이미지·영상 입력, 카드·은행 내역 프로필 응답, JSON 파싱, 컨텍스트 한도, 디코딩 오류와 영상 프레임 타임라인을 다룹니다. 미디어 테스트에는 합성 입력을 사용해 요청 처리 경계와 결과 구조를 확인합니다.',
			'별도 27B GGUF 실행 어댑터는 모델 파일의 크기와 SHA-256을 확인합니다. 체크섬 차이가 있었던 실행에서도 추론을 이어가 결과 응답을 확인했습니다.',
		],
	},
];
---

<PortfolioProjectDetail
	title="Local AI Extraction"
	eyebrow="Local AI · Vision Extraction"
	subtitle="화면 정보의 수작업 입력을 줄이기 위한 로컬 VLM 추출 파이프라인"
	description="화면에 표시된 거래 정보를 직접 입력하는 번거로움을 줄이기 위해 기존 비전 언어 모델을 Linux GPU 환경에서 실행하고, 이미지·영상의 시각 정보를 구조화된 데이터로 변환하는 추출 파이프라인을 구현했습니다."
	stack={stack}
	stackBadges={stackBadges}
	sections={sections}
	relatedPosts={[
		{
			title: '[Local VLM] Python으로 구축한 로컬 멀티모달 LLM 영상 분석 파이프라인',
			description: 'FFmpeg 프레임 샘플링부터 로컬 추론 API 연결과 JSON 결과 검증까지 이어지는 처리 흐름을 정리했습니다.',
			href: '/blog/local-vlm-python-video-pipeline/',
		},
		{
			title: '[Local VLM] 같은 영상, 다른 결과 — 멀티모달 LLM 출력 일관성 검증',
			description: '동일 영상의 추론 결과를 항목별로 비교하고, 전처리 프레임 보존 여부를 검증한 기록입니다.',
			href: '/blog/local-vlm-output-consistency-and-frame-validation/',
		},
		{
			title: '[Local VLM] Mac M5 vs RTX 3090 Ti — 27B급 로컬 비전 모델 영상 추론 성능 비교',
			description: '서로 다른 로컬 추론 환경의 실행 시간과 모델 입력 경로를 구분해 비교했습니다.',
			href: '/blog/local-vlm-mac-m5-vs-rtx3090ti/',
		},
	]}
/>
