---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const sections = [
	{
		eyebrow: '추론 런타임',
		title: '요청을 GPU 모델 실행까지 전달하는 런타임',
		paragraphs: ['Linux NVIDIA GPU 서버에서 Qwen 27B GGUF 모델을 구동하는 CUDA·llama.cpp 환경을 구성했습니다. Docker가 실행 환경을 담고, Python HTTP 어댑터가 추론 요청을 llama-server 프로세스로 전달합니다.'],
		flow: ['Python HTTP adapter', 'llama-server', 'Qwen GGUF model', 'NVIDIA GPU / CUDA'],
		cards: [
			{ title: '빌드와 실행 분리', body: 'CUDA 개발 이미지를 이용해 llama.cpp 서버를 빌드하고, 런타임 이미지에는 필요한 실행 파일과 라이브러리를 옮깁니다.' },
			{ title: '컨테이너 실행', body: '모델 파일을 이미지에 굽지 않고 실행 환경에 읽기 전용으로 연결해 모델 수명주기와 엔진 이미지를 분리합니다.' },
		],
	},
	{
		eyebrow: '모델 무결성',
		title: '모델 기준 리비전이 다르면 서버를 시작하지 않도록',
		paragraphs: ['어댑터 시작 단계에서 기대 파일 크기와 SHA-256을 대조하고 일치하지 않으면 llama-server 실행을 중단합니다. 모델 리비전과 파일 식별을 실행 조건에 포함해, 다른 GGUF 파일이 조용히 서비스되는 상황을 막았습니다.'],
	},
	{
		eyebrow: '실행 관찰',
		title: '추론과 GPU 자원을 함께 측정',
		paragraphs: ['벤치마크 실행과 GPU·시스템 자원 모니터링을 연결해 각 추론 작업의 지연 시간과 메모리 사용을 함께 추적하도록 했습니다.'],
	},
	{
		eyebrow: '현재 기술 과제',
		title: '모델 검증과 CUDA 이미지 재빌드를 각각 다루다',
		paragraphs: ['고정 리비전 모델의 체크섬과 반복 읽기 검증을 기록했고, 이후 로컬 복사본이 기준 리비전과 달랐을 때 어댑터가 이를 차단하도록 했습니다. 깨끗한 환경에서 CUDA 이미지를 다시 빌드하는 과정은 컴파일 오류가 남아 있습니다. 다음 단계는 호스트와 컴파일 조건을 고정해 이미지 빌드까지 재현하는 것입니다.'],
	},
];
---

<PortfolioProjectDetail
	title="Linux Qwen Extraction"
	eyebrow="Linux · GPU · AI Inference"
