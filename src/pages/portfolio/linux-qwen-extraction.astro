	{ name: 'NVIDIA GPU', url: 'https://img.shields.io/badge/NVIDIA_GPU-76B900?style=for-the-badge&logo=nvidia&logoColor=white' },
	{ name: 'CUDA', url: 'https://img.shields.io/badge/CUDA-76B900?style=for-the-badge&logo=nvidia&logoColor=white' },
	{ name: 'llama.cpp', url: 'https://img.shields.io/badge/llama.cpp-3B82F6?style=for-the-badge' },
	{ name: 'GGUF', url: 'https://img.shields.io/badge/GGUF-5B5B5B?style=for-the-badge' },
	{ name: 'Qwen', url: 'https://img.shields.io/badge/Qwen-615EFF?style=for-the-badge&logo=alibabacloud&logoColor=white' },
	{ name: 'Docker', url: 'https://img.shields.io/badge/Docker-2496ED?style=for-the-badge&logo=docker&logoColor=white' },
	{ name: 'Python', url: 'https://img.shields.io/badge/Python-3670A0?style=for-the-badge&logo=python&logoColor=ffdd54' },
	{ name: 'FastAPI', url: 'https://img.shields.io/badge/FastAPI-009688?style=for-the-badge&logo=fastapi&logoColor=white' },
	{ name: 'FFmpeg', url: 'https://img.shields.io/badge/FFmpeg-007808?style=for-the-badge&logo=ffmpeg&logoColor=white' },
];

const sections = [
	{
		eyebrow: '01 · 문제와 구현 결과',
		title: '이미지·영상의 시각 정보를 구조화된 JSON으로 변환',
		paragraphs: [
			'화면에 표시된 거래 정보를 사람이 직접 확인해 입력하는 과정을 줄이기 위해, 이미지와 영상에서 필요한 정보를 추출해 애플리케이션에서 사용할 구조화된 JSON으로 반환하는 API를 구현했습니다.',
			'기존 Qwen 계열 비전 언어 모델을 로컬 추론 환경에 연결하고, FastAPI에서 입력 검증부터 전처리·추론 요청·응답 파싱까지 이어지는 처리 흐름을 구성했습니다.',
		],
	},
	{
		eyebrow: '02 · 이미지·영상 추출 파이프라인',
		title: '입력 형식에 맞춰 검증·전처리한 뒤 JSON 결과 반환',
		paragraphs: [
			'FastAPI는 이미지와 영상의 형식 및 크기를 확인합니다. 영상 입력에는 FFprobe로 스트림과 프레임 시각을 확인하고 FFmpeg로 2 FPS 샘플을 구성합니다. 원본 프레임 시각의 순서와 생성된 샘플 타임라인을 각각 검사하며, 가변 프레임률 원본의 긴 간격은 디코딩 실패와 구분해 처리합니다.',
			'검증된 입력을 OpenAI 호환 API를 제공하는 llama-server에 전달합니다. LlamaClient가 입력 토큰과 컨텍스트 한도를 확인한 뒤 추론을 요청하고, 응답 파서는 모델 출력을 애플리케이션에서 사용할 JSON 필드로 변환합니다.',
		],
		flow: ['이미지·영상 업로드', '입력별 검증·전처리', 'Qwen GGUF 로컬 추론', '응답 파싱', '구조화된 JSON 반환'],
		bullets: [
			'허용 이미지·영상 형식과 파일 데이터 일치, 업로드 크기 및 영상 길이 제한 확인',
			'영상은 FFprobe로 스트림과 원본 프레임 시각을 확인하고 FFmpeg로 CFR 2 FPS 샘플 생성',
			'원본 프레임 시각의 순서와 출력 샘플 그리드의 완전성을 검사',
			'컨텍스트 한도, 추론 서버 응답, JSON 파싱 결과를 확인해 API 응답 구성',
		],
	},
	{
		eyebrow: '03 · Linux GPU 기반 추론 환경',
		title: 'FastAPI와 llama.cpp 모델 서버의 역할 분리',
		paragraphs: [
			'Linux GPU 환경에서 Docker Compose로 FastAPI 추출 API 실행 구성을 관리하고, llama.cpp 모델 서버와 HTTP로 연결했습니다. Qwen GGUF 모델 추론은 NVIDIA GPU와 CUDA를 사용합니다.',
			'FastAPI는 업로드 검증·미디어 전처리·응답 변환을 맡고, llama.cpp 서버는 모델 추론을 담당합니다. 모델 파일은 읽기 전용으로 연결하며, API에서 입력 토큰과 컨텍스트 한도를 확인하고 동시 추론 요청을 제한합니다.',
		],
		flow: ['FastAPI · 검증 / 전처리', '내부 HTTP 요청', 'llama.cpp · Qwen GGUF', 'NVIDIA GPU · CUDA'],
	},
	{
		eyebrow: '04 · 입력 처리 및 결과 검증',
		title: '합성 미디어로 입력 경계와 응답 구조를 검증',
		paragraphs: [
			'pytest와 FastAPI TestClient로 이미지·영상 입력, 카드·은행 내역 프로필별 응답 구조, JSON 파싱, 컨텍스트 한도, 디코딩 오류와 프레임 타임라인 처리를 확인했습니다. 미디어 테스트에는 합성 입력을 사용해 API 경계와 반환 구조를 검증했습니다.',
			'실제 영상 입력으로 수행한 추론 출력 비교와 전처리 프레임 검증은 실행 환경 및 비교 조건을 구분해 Related Notes에 정리했습니다.',
		],
	},
];
---

<PortfolioProjectDetail
	title="Local AI Extraction"
	eyebrow="Local AI · Vision Extraction"
	subtitle="이미지·영상의 시각 정보를 로컬 VLM으로 추출해 JSON으로 변환하는 파이프라인"
	description="화면의 거래 정보를 직접 입력하는 과정을 줄이기 위해 이미지·영상 입력 검증, 전처리, 로컬 VLM 추론, 결과 파싱을 연결해 구조화된 JSON으로 반환하는 추출 API를 구현했습니다."
	stack={stack}
	stackBadges={stackBadges}
	sections={sections}
	relatedPosts={[
		{
			title: '[Local VLM] Python으로 구축한 로컬 멀티모달 LLM 영상 분석 파이프라인',
			description: 'FFmpeg 프레임 샘플링부터 로컬 추론 API 연결과 JSON 결과 검증까지 이어지는 처리 흐름을 정리했습니다.',
			href: '/blog/local-vlm-python-video-pipeline/',
		},
		{
			title: '[Local VLM] 같은 영상, 다른 결과 — 멀티모달 LLM 출력 일관성 검증',
			description: '동일 영상의 추론 결과를 항목별로 비교하고, 전처리 프레임 보존 여부를 검증한 기록입니다.',
			href: '/blog/local-vlm-output-consistency-and-frame-validation/',
		},
		{
			title: '[Local VLM] Mac M5 vs RTX 3090 Ti — 27B급 로컬 비전 모델 영상 추론 성능 비교',
			description: '서로 다른 로컬 추론 환경의 실행 시간과 모델 입력 경로를 구분해 비교했습니다.',
			href: '/blog/local-vlm-mac-m5-vs-rtx3090ti/',
		},
	]}
/>
