---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const stack = ['Linux', 'NVIDIA GPU', 'CUDA', 'llama.cpp', 'GGUF', 'Qwen', 'Docker', 'Python', 'FastAPI', 'FFmpeg'];
const stackBadges = [
