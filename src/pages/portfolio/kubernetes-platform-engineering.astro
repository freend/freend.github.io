---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const stack = ['Kubernetes', 'Helm', 'Gateway API', 'Deployment', 'Service', 'HTTPRoute'];
const stackBadges = [
	{ name: 'Kubernetes', url: 'https://img.shields.io/badge/Kubernetes-326CE5?style=for-the-badge&logo=kubernetes&logoColor=white' },
	{ name: 'Helm', url: 'https://img.shields.io/badge/Helm-0F1689?style=for-the-badge&logo=helm&logoColor=white' },
	{ name: 'Gateway API', url: 'https://img.shields.io/badge/Gateway_API-326CE5?style=for-the-badge&logo=kubernetes&logoColor=white' },
	{ name: 'Deployment', url: 'https://img.shields.io/badge/Deployment-326CE5?style=for-the-badge&logo=kubernetes&logoColor=white' },
	{ name: 'Service', url: 'https://img.shields.io/badge/Service-326CE5?style=for-the-badge&logo=kubernetes&logoColor=white' },
	{ name: 'HTTPRoute', url: 'https://img.shields.io/badge/HTTPRoute-326CE5?style=for-the-badge&logo=kubernetes&logoColor=white' },
];

const sections = [
	{
		eyebrow: '01 · WHY',
		title: '애플리케이션 실행부터 외부 요청 전달까지 운영 경계를 정리했습니다',
		paragraphs: [
			'여러 애플리케이션을 Kubernetes에 배포할 때 실행 구성, 클러스터 내부 접근, 외부 요청 경로와 준비 상태를 함께 관리해야 했습니다. 회사의 배포 정책과 워크로드 요구에 맞춰 각 책임을 Kubernetes 리소스와 Helm 배포 설정으로 구성했습니다.',
		],
	},
	{
		eyebrow: '02 · HOW',
		title: '실행 구성과 요청 전달 경로를 각각의 리소스로 구성',
		paragraphs: [
			'Deployment는 애플리케이션 Pod의 실행 구성을, Service는 클러스터 내부 접근 지점을, Gateway API의 HTTPRoute는 외부 요청 경로를 담당하도록 구성했습니다. 각 리소스가 맡는 경계를 나눠 배포 설정과 서비스 노출 경로를 관리했습니다.',
			'워크로드에는 readiness/liveness probe와 Resource Requests·Limits를 설정하고, ConfigMap·Secret 참조로 실행 설정을 Pod 정의와 분리했습니다.',
		],
		flow: ['Deployment', 'Service', 'Gateway API · HTTPRoute'],
		cards: [
			{ title: '워크로드 실행', body: 'Deployment에 실행 설정과 Probe를 두고, Resource Requests·Limits로 워크로드의 자원 기준을 정의했습니다.' },
			{ title: '서비스 접근 경로', body: 'Service의 클러스터 내부 접근 지점과 HTTPRoute의 외부 요청 경로를 구성했습니다.' },
		],
	},
	{
		eyebrow: '03 · WHAT',
		title: '배포·라우팅·실행 상태를 확인할 구성을 만들었습니다',
		bullets: [
			'Deployment, Service, Gateway API·HTTPRoute와 CronJob 리소스 구성',
			'워크로드별 Probe, Resource Requests·Limits, ConfigMap·Secret 참조 설정',
			'kubectl apply와 Helm upgrade로 적용한 뒤 rollout 및 readiness 상태 확인',
		],
	},
	{
		eyebrow: '04 · ENGINEERING DECISIONS',
		title: '실행 변경과 트래픽 경로 변경의 대상을 구분했습니다',
		paragraphs: [
			'애플리케이션 실행 설정과 서비스 라우팅을 각 리소스의 역할에 맞춰 나눴습니다. 이 구조에서는 변경할 설정과 배포 후 확인할 상태를 Deployment, Service, HTTPRoute 단위로 구분할 수 있습니다.',
			'Probe와 자원 기준은 워크로드 설정에 두고, 매니페스트 및 Helm 적용 뒤에는 rollout과 readiness 상태를 확인했습니다.',
		],
	},
];
---

<PortfolioProjectDetail
	title="Kubernetes Platform Engineering"
	eyebrow="직접 설계·구축·관리 · Container Platform"
	subtitle="Deployment 실행 구성부터 Gateway API 요청 경로까지 관리한 Kubernetes 플랫폼"
	description="회사 배포 정책과 워크로드 요구에 맞춰 Deployment·Service·HTTPRoute를 구성하고, 애플리케이션 실행 상태와 외부 요청 경로를 관리했습니다."
	stack={stack}
	stackBadges={stackBadges}
	sections={sections}
	relatedLinks={[
		{ label: 'Kubernetes Autoscaling', href: '/portfolio/kubernetes-autoscaling' },
		{ label: 'Kubernetes Observability', href: '/portfolio/kubernetes-observability' },
	]}
/>
