---
import PortfolioProjectDetail from '../../components/PortfolioProjectDetail.astro';

const stack = ['Kubernetes', 'Helm', 'Gateway API', 'Deployment', 'Service', 'HTTPRoute'];
const stackBadges = [
	{ name: 'Kubernetes', url: 'https://img.shields.io/badge/Kubernetes-326CE5?style=for-the-badge&logo=kubernetes&logoColor=white' },
	{ name: 'Helm', url: 'https://img.shields.io/badge/Helm-0F1689?style=for-the-badge&logo=helm&logoColor=white' },
	{ name: 'Gateway API', url: 'https://img.shields.io/badge/Gateway_API-326CE5?style=for-the-badge&logo=kubernetes&logoColor=white' },
	{ name: 'Deployment', url: 'https://img.shields.io/badge/Deployment-326CE5?style=for-the-badge&logo=kubernetes&logoColor=white' },
	{ name: 'Service', url: 'https://img.shields.io/badge/Service-326CE5?style=for-the-badge&logo=kubernetes&logoColor=white' },
	{ name: 'HTTPRoute', url: 'https://img.shields.io/badge/HTTPRoute-326CE5?style=for-the-badge&logo=kubernetes&logoColor=white' },
];

const sections = [
	{
		eyebrow: '01 · WHY',
		title: '회사 배포 정책에 맞는 Kubernetes 운영 기반을 만들기 위해',
		paragraphs: [
			'여러 애플리케이션을 Kubernetes에 배포하고 서비스 노출과 실행 상태를 일관되게 관리할 필요가 있었습니다. 회사의 서비스 운영 정책과 워크로드 요구사항을 Kubernetes 리소스로 구체화했습니다.',
		],
	},
	{
		eyebrow: '02 · HOW',
		title: '워크로드, 서비스, 외부 라우팅의 역할을 나눠 구성',
		paragraphs: [
			'Deployment로 애플리케이션 실행 구성을 정의하고 Service로 클러스터 내부 접근 지점을 만들었습니다. Gateway API의 HTTPRoute를 이용해 서비스 요청 경로를 구성했습니다.',
			'각 워크로드에는 readiness/liveness probe와 Resource Requests·Limits를 설정했습니다. ConfigMap과 Secret 참조를 통해 실행 설정을 Pod 정의와 분리해 다뤘습니다.',
		],
		flow: ['Deployment', 'Service', 'Gateway API · HTTPRoute'],
		cards: [
			{ title: '실행과 상태 확인', body: 'Probe로 컨테이너의 준비 상태와 생존 상태를 정의하고, 리소스 요청·제한으로 워크로드 자원 설정을 관리했습니다.' },
			{ title: '서비스 노출', body: 'Service와 HTTPRoute를 사용해 애플리케이션 간 접근과 외부 요청 라우팅을 구성했습니다.' },
		],
	},
	{
		eyebrow: '03 · WHAT',
		title: 'Kubernetes 리소스를 작성하고 적용 상태를 확인했습니다',
		bullets: [
			'Deployment, Service, Gateway API·HTTPRoute 및 CronJob 구성',
			'Probe, Resource Requests·Limits, ConfigMap·Secret 참조 설정',
			'kubectl apply, Helm upgrade 후 rollout 및 readiness 상태 확인',
		],
	},
	{
		eyebrow: '04 · ENGINEERING DECISIONS',
		title: '애플리케이션 실행과 트래픽 경로를 각각 Kubernetes 리소스로 관리',
		paragraphs: [
			'워크로드 실행 설정과 서비스 라우팅 설정을 서로 다른 리소스로 다뤄 변경 지점을 구분했습니다. Probe와 자원 기준을 함께 관리해 배포 후 애플리케이션 상태를 확인할 수 있도록 했습니다.',
			'매니페스트와 Helm 적용 이력을 배포와 변경 관리에 활용하고, rollout 및 readiness 상태를 확인했습니다.',
		],
	},
];
---

<PortfolioProjectDetail
	title="Kubernetes Platform Engineering"
	eyebrow="직접 설계·구축·관리 · Container Platform"
	subtitle="애플리케이션 배포와 서비스 노출을 위한 Kubernetes 플랫폼 구성"
	description="회사의 배포·운영 정책에 맞춰 Kubernetes 리소스를 설계하고 애플리케이션 배포, 서비스 라우팅, 상태 확인 구성을 관리했습니다."
	stack={stack}
	stackBadges={stackBadges}
	sections={sections}
	relatedLinks={[
		{ label: 'Kubernetes Autoscaling', href: '/portfolio/kubernetes-autoscaling' },
		{ label: 'Kubernetes Observability', href: '/portfolio/kubernetes-observability' },
	]}
/>
