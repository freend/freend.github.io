---
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import { SITE_TITLE } from '../consts';

interface DetailCard {
	title: string;
	body: string;
}

interface DetailTable {
	caption: string;
	headers: string[];
	rows: string[][];
}

interface DetailCode {
	language: string;
	content: string;
}

interface DetailSection {
	eyebrow?: string;
	title: string;
	paragraphs?: string[];
	bullets?: string[];
	flow?: string[];
	flowSteps?: { label: string; detail: string }[];
	flowLayout?: 'horizontal-scroll';
	cards?: DetailCard[];
	table?: DetailTable;
	code?: DetailCode;
	formula?: string;
	note?: string;
}

interface StackBadge {
	name: string;
	url: string;
}

interface RelatedLink {
	label: string;
	href: string;
}

interface RelatedPost {
	title: string;
	description: string;
	href: string;
}

interface Props {
	title: string;
	eyebrow: string;
	subtitle: string;
	description: string;
	stack: string[];
	stackBadges?: StackBadge[];
	relatedLinks?: RelatedLink[];
	relatedPosts?: RelatedPost[];
	sections: DetailSection[];
	demoUrl?: string;
}

const { title, eyebrow, subtitle, description, stack, stackBadges, relatedLinks, relatedPosts, sections, demoUrl } = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} />
	</head>
	<body>
		<Header />
		<main class="project-detail">
			<nav class="breadcrumbs" aria-label="현재 위치"><a href="/portfolio">Portfolio</a><span aria-hidden="true"> / </span><span>{title}</span></nav>
			<header class="project-hero">
				<p class="eyebrow">{eyebrow}</p>
				<h1>{title}</h1>
				<p class="project-subtitle">{subtitle}</p>
				<p>{description}</p>
				{stackBadges ? (
					<ul class="stack-badges" aria-label="주요 기술">
						{stackBadges.map((badge) => <li><img src={badge.url} alt={badge.name} /></li>)}
					</ul>
				) : (
					<ul class="tag-list" aria-label="주요 기술">{stack.map((item) => <li>{item}</li>)}</ul>
				)}
				<div class="hero-actions">
					{demoUrl && <a class="button button-primary" href={demoUrl} target="_blank" rel="noopener noreferrer">공개 데모 <span aria-hidden="true">↗</span></a>}
					<a class="button button-secondary" href="/portfolio">Portfolio로 돌아가기</a>
				</div>
			</header>

			{sections.map((section, index) => (
				<section class="content-section" aria-labelledby={`section-${index}-title`}>
					{section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
					<h2 id={`section-${index}-title`}>{section.title}</h2>
					{section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
					{section.flow && <p class="flow">{section.flow.map((item, itemIndex) => <>{itemIndex > 0 && <span aria-hidden="true"> → </span>}{item}</>)}</p>}
					{section.flowSteps && (
						<div
							class={section.flowLayout === 'horizontal-scroll' ? 'flow-diagram-scroll-shell flow-diagram-scroll-shell--enabled' : 'flow-diagram-scroll-shell'}
							tabindex={section.flowLayout === 'horizontal-scroll' ? 0 : undefined}
							role={section.flowLayout === 'horizontal-scroll' ? 'region' : undefined}
							aria-label={section.flowLayout === 'horizontal-scroll' ? '데이터 흐름도' : undefined}
							aria-describedby={section.flowLayout === 'horizontal-scroll' ? 'kafka-flow-scroll-hint' : undefined}
						>
							<ol
								class={section.flowLayout === 'horizontal-scroll' ? 'flow-diagram flow-diagram-horizontal' : 'flow-diagram'}
								aria-label="데이터 처리 흐름"
							>
								{section.flowSteps.map((step) => (
									<li class="flow-diagram-step">
										<strong>{step.label}</strong>
										<span>{step.detail}</span>
									</li>
								))}
							</ol>
							{section.flowLayout === 'horizontal-scroll' && (
								<p id="kafka-flow-scroll-hint" class="flow-diagram-scroll-hint">좌우로 스크롤하여 전체 흐름 보기</p>
							)}
						</div>
					)}
					{section.bullets && <ul class="feature-list">{section.bullets.map((item) => <li>{item}</li>)}</ul>}
					{section.cards && (
						<div class="detail-grid">
							{section.cards.map((card) => <article><h3>{card.title}</h3><p>{card.body}</p></article>)}
						</div>
					)}
					{section.formula && <p class="detail-formula"><code>{section.formula}</code></p>}
					{section.code && <pre class="detail-code"><code class={`language-${section.code.language}`}>{section.code.content}</code></pre>}
					{section.table && (
						<div class="detail-table-wrap" role="region" aria-label={section.table.caption} tabindex="0">
							<table class="detail-table">
								<caption>{section.table.caption}</caption>
								<thead><tr>{section.table.headers.map((header) => <th scope="col">{header}</th>)}</tr></thead>
								<tbody>{section.table.rows.map((row) => <tr>{row.map((cell, cellIndex) => cellIndex === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody>
							</table>
						</div>
					)}
					{section.note && <p class="scope-note">{section.note}</p>}
				</section>
			))}

			{relatedPosts?.length && (
				<section class="related-posts" aria-labelledby="related-posts-title">
					<p class="eyebrow">RELATED NOTES</p>
					<h2 id="related-posts-title">관련 기술 기록</h2>
					<p class="related-posts-intro">로컬 AI 추론 환경을 구축하고 이미지·영상 추출 파이프라인을 실험하며 정리한 기술 기록입니다.</p>
					<ul class="related-post-list">
						{relatedPosts.map((post) => (
							<li>
								<a href={post.href}>
									<strong>{post.title}</strong>
									<span>{post.description}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			{relatedLinks?.length && (
				<nav class="related-projects" aria-label="연결된 프로젝트 상세 페이지">
					<p class="eyebrow">RELATED PROJECTS</p>
					{relatedLinks.map((link) => <a class="button button-secondary" href={link.href}>{link.label}<span aria-hidden="true"> →</span></a>)}
				</nav>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.project-detail { line-height: 1.75; }
	.breadcrumbs { margin: 1.5rem 0 1rem; color: #656d76; font-size: 0.9rem; }
	.project-hero { padding: 1rem 0 2.25rem; border-bottom: 1px solid var(--border); }
	.eyebrow { margin: 0 0 0.65rem; color: var(--link); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; }
	.project-hero h1 { margin: 0; border: 0; padding: 0; font-size: clamp(2.5rem, 8vw, 4rem); letter-spacing: -0.04em; }
	.project-subtitle { margin: 0.75rem 0 1rem; font-size: 1.25rem; font-weight: 600; }
	.project-hero > p:not(.eyebrow):not(.project-subtitle) { max-width: 680px; color: #656d76; }
	.tag-list { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1rem 0 0; padding: 0; list-style: none; }
	.tag-list li { margin: 0; padding: 0.2rem 0.55rem; border: 1px solid var(--border); border-radius: 999px; color: #656d76; font-size: 0.82rem; }
	.stack-badges { display: flex; flex-wrap: wrap; gap: 0.5rem; max-width: 100%; margin: 1rem 0 0; padding: 0; list-style: none; }
	.stack-badges li { max-width: 100%; margin: 0; }
	.stack-badges img { display: block; max-width: 100%; height: 24px; border: 0; filter: none; }
	.hero-actions { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 1.35rem; }
	.related-projects { display: flex; flex-wrap: wrap; align-items: center; gap: 0.65rem; margin: 3rem 0; padding-top: 1.25rem; border-top: 1px solid var(--border); }
	.related-projects .eyebrow { flex-basis: 100%; margin-bottom: 0; }
	.button { display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.65rem 0.95rem; border: 1px solid var(--border); border-radius: 6px; font-weight: 600; }
	.button-primary { border-color: var(--link); background: var(--link); color: #fff; }
	.button-secondary { background: var(--bg); }
	.content-section { margin: 3.5rem 0; }
	.content-section h2 { margin: 0 0 1rem; }
	.related-posts { margin: 3rem 0; padding-top: 1.4rem; border-top: 1px solid var(--border); }
	.related-posts .eyebrow { margin-bottom: 0.35rem; }
	.related-posts h2 { margin: 0 0 0.5rem; border: 0; padding: 0; font-size: 1.25rem; }
	.related-posts-intro { max-width: 700px; margin: 0 0 1rem; color: #656d76; }
	.related-post-list { display: grid; gap: 0.45rem; margin: 0; padding: 0; list-style: none; }
	.related-post-list li { margin: 0; }
	.related-post-list a { display: block; max-width: 820px; padding: 0.3rem 0; overflow-wrap: anywhere; }
	.related-post-list strong, .related-post-list span { display: block; }
	.related-post-list strong { font-weight: 600; }
	.related-post-list span { margin-top: 0.12rem; color: #656d76; font-size: 0.9rem; }
	.detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 1.25rem 0; }
	.detail-grid article { padding: 1.1rem; border: 1px solid var(--border); border-radius: 8px; }
	.detail-grid h3 { margin: 0 0 0.5rem; font-size: 1rem; }
	.detail-grid p { margin-bottom: 0; }
	.flow { color: var(--link); font-weight: 650; overflow-wrap: anywhere; }
	.flow span { padding: 0 0.2rem; color: #656d76; }
	.flow-diagram { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0.65rem; margin: 1.35rem 0 0; padding: 0; list-style: none; }
	.flow-diagram-step { position: relative; display: flex; min-width: 0; min-height: 6.25rem; flex-direction: column; justify-content: center; gap: 0.35rem; padding: 0.75rem 0.55rem; border: 1px solid var(--border); border-radius: 8px; background: var(--code-bg); text-align: center; overflow-wrap: anywhere; }
	.flow-diagram-step:not(:last-child)::after { position: absolute; top: 50%; right: -0.58rem; z-index: 1; color: var(--link); content: '→'; font-weight: 700; transform: translate(50%, -50%); }
	.flow-diagram-step strong { font-size: 0.78rem; line-height: 1.3; }
	.flow-diagram-step span { color: #656d76; font-size: 0.75rem; line-height: 1.4; }
	.flow-diagram-scroll-shell { display: contents; }
	.flow-diagram-scroll-shell--enabled { display: block; width: 100%; max-width: 100%; min-width: 0; overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; }
	.flow-diagram-scroll-shell--enabled:focus-visible { outline: 2px solid var(--link); outline-offset: 3px; }
	.flow-diagram-horizontal { grid-template-columns: none; grid-template-rows: minmax(150px, auto); grid-auto-flow: column; grid-auto-columns: 240px; gap: 24px; width: max-content; padding: 0.25rem 0.85rem 0.5rem 0.25rem; }
	.flow-diagram-horizontal .flow-diagram-step { width: 240px; min-height: 150px; box-sizing: border-box; }
	.flow-diagram-horizontal .flow-diagram-step:not(:last-child)::after { top: 50%; right: auto; bottom: auto; left: calc(100% + 12px); transform: translate(-50%, -50%); }
	.flow-diagram-scroll-hint { margin: 0.45rem 0 0; color: #656d76; font-size: 0.85rem; text-align: right; }
	.scope-note { padding: 0.9rem 1rem; border-left: 3px solid var(--link); background: var(--code-bg); }
	.detail-formula { margin: 1rem 0; }
	.detail-formula code { padding: 0.45rem 0.7rem; font-size: 1rem; }
	.detail-code { max-width: 100%; overflow-x: auto; padding: 1rem; border: 1px solid var(--border); border-radius: 6px; background: var(--code-bg); }
	.detail-code code { padding: 0; background: transparent; font-size: 0.88rem; }
	.detail-table-wrap { max-width: 100%; margin: 1rem 0 1.5rem; overflow-x: auto; border: 1px solid var(--border); border-radius: 6px; }
	.detail-table { width: 100%; min-width: 46rem; border-collapse: collapse; font-size: 0.9rem; }
	.detail-table caption { padding: 0.75rem 1rem; color: var(--text); font-weight: 600; text-align: left; }
	.detail-table th, .detail-table td { padding: 0.7rem 0.85rem; border-top: 1px solid var(--border); text-align: left; vertical-align: top; }
	.detail-table thead th { background: var(--code-bg); font-weight: 600; }
	.detail-table tbody th { font-weight: 600; white-space: nowrap; }
	@media (max-width: 600px) {
		.detail-grid { grid-template-columns: 1fr; }
		.project-subtitle { font-size: 1.1rem; }
	}
	@media (max-width: 700px) {
		.flow-diagram { grid-template-columns: 1fr; gap: 0.6rem; max-width: 28rem; margin-inline: auto; }
		.flow-diagram-step { min-height: 0; padding: 0.8rem 1rem; }
		.flow-diagram-step:not(:last-child)::after { top: auto; right: auto; bottom: -0.6rem; left: 50%; content: '↓'; transform: translate(-50%, 50%); }
		.flow-diagram-scroll-shell--enabled { width: auto; max-width: 100%; overflow: visible; }
		.flow-diagram-horizontal { grid-template-columns: 1fr; grid-template-rows: none; grid-auto-flow: row; grid-auto-columns: auto; grid-auto-rows: auto; gap: 0.6rem; width: 100%; max-width: 28rem; margin-inline: auto; padding: 0; }
		.flow-diagram-horizontal .flow-diagram-step { width: auto; min-height: 0; padding: 0.8rem 1rem; }
		.flow-diagram-horizontal .flow-diagram-step:not(:last-child)::after { top: auto; right: auto; bottom: -0.6rem; left: 50%; content: '↓'; transform: translate(-50%, 50%); }
		.flow-diagram-scroll-hint { display: none; }
	}
</style>
