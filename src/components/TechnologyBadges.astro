---
interface TechnologyBadge {
	name: string;
	url: string;
}

interface Props {
	badges: TechnologyBadge[];
	label?: string;
	compact?: boolean;
}

const { badges, label = '주요 기술', compact = false } = Astro.props;
---

<ul class:list={['technology-badges', { compact }]} aria-label={label}>
	{badges.map((badge) => (
		<li><img src={badge.url} alt={badge.name} loading="lazy" /></li>
	))}
</ul>

<style>
	.technology-badges { display: flex; flex-wrap: wrap; gap: 0.5rem; max-width: 100%; margin: 1rem 0 0; padding: 0; list-style: none; }
	.technology-badges li { max-width: 100%; margin: 0; }
	.technology-badges img { display: block; max-width: 100%; height: 24px; border: 0; filter: none; }
	.technology-badges.compact { gap: 0.45rem; margin-top: 0; }
	@media (max-width: 600px) {
		.technology-badges img { height: 22px; }
		.technology-badges.compact { gap: 0.4rem; }
	}
</style>
