---
interface Badge {
	name: string;
	url: string;
}

interface Props {
	badges: Badge[];
	label?: string;
	compact?: boolean;
}

const { badges, label = '주요 기술', compact = false } = Astro.props;
const className = compact ? 'stack-badges stack-badges--compact' : 'stack-badges';
---

<ul class={className} aria-label={label}>
	{badges.map((badge) => (
		<li><img src={badge.url} alt={badge.name} loading="lazy" /></li>
	))}
</ul>

<style>
	.stack-badges { display: flex; flex-wrap: wrap; gap: 0.5rem; max-width: 100%; margin: 1rem 0 0; padding: 0; list-style: none; }
	.stack-badges li { max-width: 100%; margin: 0; }
	.stack-badges img { display: block; max-width: 100%; height: 24px; border: 0; filter: none; }
	.stack-badges--compact { gap: 0.45rem; margin: 0; }
	@media (max-width: 600px) {
		.stack-badges--compact { gap: 0.4rem; }
		.stack-badges--compact img { height: 22px; }
	}
</style>
