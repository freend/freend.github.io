		],
		links: [
			{ label: 'Collect Dashboard API', href: '/portfolio/collect-dashboard-api' },
			{ label: 'Ent-360 Insight Dashboard', href: '/portfolio/ent-360-insight-dashboard' },
			{ label: 'DART Data Collection', href: '/portfolio/dart-data-collection' },
			{ label: 'Cross-Database Data Synchronization', href: '/portfolio/cross-database-data-synchronization' },
			{ label: 'Whoola API', href: '/portfolio/whoola-api' },
			{ label: 'Whoola Renderer', href: '/portfolio/whoola-renderer' },
		],
	},
	{
		title: 'Local AI / Vision Extraction',
		description: 'Python·FFmpeg 입력 전처리, llama.cpp·Qwen 로컬 추론, JSON 결과 검증을 이미지·영상 처리 흐름으로 연결합니다.',
		badges: [
			{ name: 'Python', url: 'https://img.shields.io/badge/Python-3670A0?style=for-the-badge&logo=python&logoColor=ffdd54' },
			{ name: 'llama.cpp', url: 'https://img.shields.io/badge/llama.cpp-3B82F6?style=for-the-badge' },
			{ name: 'Qwen', url: 'https://img.shields.io/badge/Qwen-615EFF?style=for-the-badge&logo=alibabacloud&logoColor=white' },
			{ name: 'FFmpeg', url: 'https://img.shields.io/badge/FFmpeg-007808?style=for-the-badge&logo=ffmpeg&logoColor=white' },
		],
		links: [
			{ label: 'Local AI Extraction', href: '/portfolio/linux-qwen-extraction' },
			{ label: '영상 분석·출력 검증 기록', href: '/blog/local-vlm-output-consistency-and-frame-validation/' },
		],
	},
];
---

<section class="tech-summary" aria-labelledby="tech-summary-title">
	<div class="section-heading">
		<p class="eyebrow">TECHNICAL EXPERIENCE</p>
		<h2 id="tech-summary-title">기술을 시스템과 운영 문제에 연결합니다</h2>
	</div>
	<div class="tech-area-grid">
		{areas.map((area) => (
			<article class="tech-area">
				<h3>{area.title}</h3>
				<p>{area.description}</p>
				<div class="tech-badges">
					<TechnologyBadges badges={area.badges} label={`${area.title} 기술`} compact />
				</div>
				<nav aria-label={`${area.title} 프로젝트`}>
					{area.links.map((link) => <a href={link.href}>{link.label}<span aria-hidden="true"> →</span></a>)}
				</nav>
			</article>
		))}
	</div>
</section>

<style>
	.tech-summary { margin: 3.5rem 0; }
	.section-heading { margin-bottom: 1.25rem; }
	.eyebrow { margin: 0 0 0.65rem; color: var(--link); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; }
	.section-heading h2 { margin: 0; }
	.tech-area-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
	.tech-area { min-width: 0; padding: 1.25rem; border: 1px solid var(--border); border-radius: 8px; }
	.tech-area h3 { margin: 0 0 0.65rem; font-size: 1.1rem; color: var(--link); }
	.tech-area p { margin: 0; color: var(--text); font-size: 1rem; line-height: 1.7; }
	.tech-badges { margin: 0.9rem 0; }
	.tech-area nav { display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; margin-top: 0.9rem; font-size: 0.95rem; }
	.tech-area nav a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
	.tech-area nav a:focus-visible { outline: 3px solid var(--link); outline-offset: 3px; }
	@media (max-width: 700px) { .tech-area-grid { grid-template-columns: 1fr; } }
</style>
