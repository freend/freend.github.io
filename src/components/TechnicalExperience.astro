		badges: [
			{ name: 'AWS', url: 'https://img.shields.io/badge/AWS-232F3E?style=for-the-badge&logo=amazonaws&logoColor=white' },
			{ name: 'Terraform', url: 'https://img.shields.io/badge/Terraform-7B42BC?style=for-the-badge&logo=terraform&logoColor=white' },
			{ name: 'Ansible', url: 'https://img.shields.io/badge/Ansible-EE0000?style=for-the-badge&logo=ansible&logoColor=white' },
		],
		links: [
			{ label: 'AWS Infrastructure as Code', href: '/portfolio/aws-infrastructure-as-code' },
			{ label: 'Server Configuration Automation', href: '/portfolio/server-configuration-automation' },
		],
	},
	{
		title: 'Kubernetes / Platform',
		description: 'Deployment·Service와 Gateway API로 서비스 배포·라우팅을 구성하고, Karpenter와 Prometheus·Loki·Alloy로 노드 운영 및 메트릭·로그 수집을 다룹니다.',
		badges: [
			{ name: 'Kubernetes', url: 'https://img.shields.io/badge/Kubernetes-326CE5?style=for-the-badge&logo=kubernetes&logoColor=white' },
			{ name: 'Helm', url: 'https://img.shields.io/badge/Helm-0F1689?style=for-the-badge&logo=helm&logoColor=white' },
			{ name: 'Karpenter', url: 'https://img.shields.io/badge/Karpenter-7B42BC?style=for-the-badge' },
			{ name: 'Prometheus', url: 'https://img.shields.io/badge/Prometheus-E6522C?style=for-the-badge&logo=prometheus&logoColor=white' },
			{ name: 'Grafana', url: 'https://img.shields.io/badge/Grafana-F46800?style=for-the-badge&logo=grafana&logoColor=white' },
			{ name: 'Grafana Loki', url: 'https://img.shields.io/badge/Grafana_Loki-F46800?style=for-the-badge&logo=grafana&logoColor=white' },
			{ name: 'Grafana Alloy', url: 'https://img.shields.io/badge/Grafana_Alloy-FF6B00?style=for-the-badge&logo=grafana&logoColor=white' },
		],
		links: [
			{ label: 'Platform Engineering', href: '/portfolio/kubernetes-platform-engineering' },
			{ label: 'Autoscaling', href: '/portfolio/kubernetes-autoscaling' },
			{ label: 'Observability', href: '/portfolio/kubernetes-observability' },
		],
	},
	{
		title: 'Backend / Data Engineering',
		description: 'Java·Spring과 Python·FastAPI로 API를 구현하고 SQLAlchemy·Redis·Kafka를 데이터 접근, 캐시, 집계·동기화 흐름에 활용합니다.',
		badges: [
			{ name: 'Java', url: 'https://img.shields.io/badge/Java-ED8B00?style=for-the-badge&logo=openjdk&logoColor=white' },
			{ name: 'Spring Boot', url: 'https://img.shields.io/badge/Spring_Boot-6DB33F?style=for-the-badge&logo=springboot&logoColor=white' },
			{ name: 'Python', url: 'https://img.shields.io/badge/Python-3670A0?style=for-the-badge&logo=python&logoColor=ffdd54' },
			{ name: 'FastAPI', url: 'https://img.shields.io/badge/FastAPI-009688?style=for-the-badge&logo=fastapi&logoColor=white' },
			{ name: 'Gradle', url: 'https://img.shields.io/badge/Gradle-02303A?style=for-the-badge&logo=gradle&logoColor=white' },
			{ name: 'Next.js', url: 'https://img.shields.io/badge/Next.js-black?style=for-the-badge&logo=next.js&logoColor=white' },
			{ name: 'React', url: 'https://img.shields.io/badge/React-20232A?style=for-the-badge&logo=react&logoColor=61DAFB' },
			{ name: 'TypeScript', url: 'https://img.shields.io/badge/TypeScript-3178C6?style=for-the-badge&logo=typescript&logoColor=white' },
