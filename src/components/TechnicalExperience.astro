---

<section class="tech-summary" aria-labelledby="tech-summary-title">
	<div class="section-heading">
		<p class="eyebrow">TECHNICAL EXPERIENCE</p>
		<h2 id="tech-summary-title">기술을 시스템과 운영 문제에 연결합니다</h2>
	</div>
	<div class="tech-area-grid">
		{areas.map((area) => (
			<article class="tech-area">
				<h3>{area.title}</h3>
				<p>{area.description}</p>
				<ul class="tech-badges" aria-label={`${area.title} 기술`}>
					{area.badges.map((badge) => <li><img src={badge.url} alt={badge.name} loading="lazy" /></li>)}
				</ul>
				<nav aria-label={`${area.title} 프로젝트`}>
					{area.links.map((link) => <a href={link.href}>{link.label}<span aria-hidden="true"> →</span></a>)}
				</nav>
			</article>
		))}
	</div>
</section>

<style>
	.tech-summary { margin: 4rem 0; }
	.section-heading { margin-bottom: 1.25rem; }
	.eyebrow { margin: 0 0 0.65rem; color: var(--link); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; }
	.section-heading h2 { margin: 0; }
	.tech-area-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
	.tech-area { min-width: 0; padding: 1.15rem; border: 1px solid var(--border); border-radius: 8px; }
	.tech-area h3 { margin: 0 0 0.55rem; font-size: 1rem; color: var(--link); }
	.tech-area p { margin: 0; color: #656d76; font-size: 0.95rem; line-height: 1.7; }
	.tech-badges { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 0.9rem 0; padding: 0; list-style: none; }
	.tech-badges li { min-width: 0; margin: 0; }
	.tech-badges img { display: block; max-width: 100%; height: 22px; border: 0; }
	.tech-area nav { display: flex; flex-wrap: wrap; gap: 0.35rem 0.8rem; font-size: 0.9rem; }
	@media (max-width: 700px) { .tech-area-grid { grid-template-columns: 1fr; } }
</style>
